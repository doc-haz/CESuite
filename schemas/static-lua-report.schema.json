{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/doc-haz/CESuite/schemas/static-lua-report.schema.json",
  "title": "CESuite Static Lua AOB Analysis Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "core_version",
    "suite_version",
    "ce_version",
    "generated_at",
    "completed_at",
    "observation_only",
    "target",
    "candidate_count",
    "unique_pattern_count",
    "observations",
    "diagnostics",
    "limitations"
  ],
  "properties": {
    "title": {
      "const": "CESuite Static Lua AOB Analysis"
    },
    "core_version": {
      "enum": [
        "0.1.9"
      ]
    },
    "suite_version": {
      "type": "string"
    },
    "ce_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_only": {
      "const": true
    },
    "target": {
      "type": "object",
      "required": [
        "pid",
        "attached",
        "name",
        "architecture",
        "build_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "attached": {
          "type": "boolean"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "enum": [
            "x86",
            "x64",
            "unknown"
          ]
        },
        "build_fingerprint": {
          "type": "null"
        }
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_pattern_count": {
      "type": "integer",
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "script_id",
          "line",
          "sink",
          "symbol",
          "pattern",
          "raw_pattern",
          "status",
          "confidence",
          "provenance",
          "evidence",
          "scope",
          "unknowns",
          "match_count",
          "uniqueness"
        ],
        "properties": {
          "script_id": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "sink": {
            "type": "string"
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "source-candidate",
              "unknown"
            ]
          },
          "confidence": {
            "const": "lexical"
          },
          "provenance": {
            "const": "static-lua"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match_count": {
            "type": "null"
          },
          "uniqueness": {
            "const": "unverified"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "dynamic_analysis": {
      "$ref": "#/$defs/dynamic_analysis"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_complete",
        "partial",
        "cancelled",
        "stage",
        "provenance",
        "timing_source",
        "warnings",
        "metrics"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "cancelled",
            "failed",
            "unavailable"
          ]
        },
        "source_complete": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "cancelled": {
          "type": "boolean"
        },
        "stage": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "timing_source": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "stage"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_ms",
            "parse_ms",
            "scan_ms",
            "export_ms",
            "serialize_ms",
            "write_ms",
            "source_bytes",
            "export_bytes",
            "items_processed",
            "items_total",
            "operations_attempted",
            "operations_completed"
          ],
          "properties": {
            "duration_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "parse_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "scan_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "export_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "serialize_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "write_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "source_bytes": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "export_bytes": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "items_processed": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "items_total": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "operations_attempted": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "operations_completed": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "dynamicCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "dependencies",
        "resolution",
        "fallback"
      ],
      "properties": {
        "kind": {
          "const": "conditional_expression"
        },
        "text": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "const": "unknown"
        },
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dynamicCandidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "source_script",
        "source_line",
        "consumer",
        "status",
        "runtime_validated"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "literal_pattern",
            "derived_pattern",
            "conditional_pattern",
            "symbol_only",
            "unknown"
          ]
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_script": {
          "type": "string"
        },
        "source_line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "consumer": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "runtime_validated": {
          "const": false
        },
        "condition": {
          "$ref": "#/$defs/dynamicCondition"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "discovery",
        "validation"
      ],
      "properties": {
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "units_discovered",
            "units_processed",
            "complete",
            "universe_known",
            "denominator",
            "status",
            "percentage",
            "limitations"
          ],
          "properties": {
            "scope": {
              "type": "string"
            },
            "units_discovered": {
              "type": "integer",
              "minimum": 0
            },
            "units_processed": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            },
            "universe_known": {
              "type": "boolean"
            },
            "denominator": {
              "type": "string"
            },
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable",
                "unknown",
                "limit_reached",
                "not_applicable"
              ]
            },
            "percentage": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns_discovered",
            "patterns_literal",
            "patterns_derived",
            "patterns_conditional",
            "patterns_symbol_only",
            "entities_discovered",
            "candidates",
            "linked",
            "unresolved",
            "unsupported",
            "complete",
            "universe_known",
            "denominator",
            "status",
            "percentage",
            "limitations"
          ],
          "properties": {
            "patterns_discovered": {
              "type": "integer",
              "minimum": 0
            },
            "patterns_literal": {
              "type": "integer",
              "minimum": 0
            },
            "patterns_derived": {
              "type": "integer",
              "minimum": 0
            },
            "patterns_conditional": {
              "type": "integer",
              "minimum": 0
            },
            "patterns_symbol_only": {
              "type": "integer",
              "minimum": 0
            },
            "entities_discovered": {
              "type": "integer",
              "minimum": 0
            },
            "candidates": {
              "type": "integer",
              "minimum": 0
            },
            "linked": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            },
            "universe_known": {
              "type": "boolean"
            },
            "denominator": {
              "type": "string"
            },
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable",
                "unknown",
                "limit_reached",
                "not_applicable"
              ]
            },
            "percentage": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidates",
            "runtime_attempted",
            "runtime_validated",
            "runtime_unique",
            "runtime_ambiguous",
            "runtime_no_match",
            "runtime_error",
            "runtime_unavailable",
            "unresolved",
            "unsupported",
            "complete",
            "universe_known",
            "denominator",
            "status",
            "percentage",
            "limitations"
          ],
          "properties": {
            "candidates": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_attempted": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_validated": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_unique": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_ambiguous": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_no_match": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_error": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_unavailable": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            },
            "universe_known": {
              "type": "boolean"
            },
            "denominator": {
              "type": "string"
            },
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable",
                "unknown",
                "limit_reached",
                "not_applicable"
              ]
            },
            "percentage": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dynamic_analysis": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "counts",
        "patterns",
        "edges",
        "nodes",
        "dependencies",
        "providers",
        "unresolved",
        "limits",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "limit_reached"
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "entries",
            "specs",
            "literal",
            "literal_unique",
            "derived",
            "conditional",
            "symbol_only",
            "symbol_only_pure",
            "unique_symbols",
            "candidates",
            "runtime_validated"
          ],
          "properties": {
            "entries": {
              "type": "integer",
              "minimum": 0
            },
            "specs": {
              "type": "integer",
              "minimum": 0
            },
            "literal": {
              "type": "integer",
              "minimum": 0
            },
            "literal_unique": {
              "type": "integer",
              "minimum": 0
            },
            "derived": {
              "type": "integer",
              "minimum": 0
            },
            "conditional": {
              "type": "integer",
              "minimum": 0
            },
            "symbol_only": {
              "type": "integer",
              "minimum": 0
            },
            "symbol_only_pure": {
              "type": "integer",
              "minimum": 0
            },
            "unique_symbols": {
              "type": "integer",
              "minimum": 0
            },
            "candidates": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_validated": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dynamicCandidate"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limits": {
          "type": "object"
        }
      }
    }
  }
}
