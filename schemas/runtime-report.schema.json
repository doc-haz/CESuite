          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "script_id",
              "section",
              "line",
              "command",
              "occurrence_count",
              "occurrence_indices"
            ],
            "properties": {
              "script_id": {
                "type": "string"
              },
              "section": {
                "$ref": "#/$defs/section"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "command": {
                "enum": [
                  "aobscan",
                  "aobscanmodule",
                  "aobscanregion",
                  "define",
                  "label",
                  "alloc",
                  "globalalloc",
                  "registersymbol",
                  "unregistersymbol",
                  "dealloc",
                  "address_label",
                  "lua_global_assignment",
                  "lua_global_reference"
                ]
              },
              "occurrence_count": {
                "type": "integer",
                "minimum": 1
              },
              "occurrence_indices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "lua_lexical"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "lua_global"
              },
              "name": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "locations": {
                "items": {
                  "properties": {
                    "command": {
                      "enum": [
                        "lua_global_assignment",
                        "lua_global_reference"
                      ]
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "kind": {
                "enum": [
                  "symbol",
                  "resource",
                  "registered_symbol"
                ]
              },
              "locations": {
                "items": {
                  "properties": {
                    "command": {
                      "enum": [
                        "aobscan",
                        "aobscanmodule",
                        "aobscanregion",
                        "define",
                        "label",
                        "alloc",
                        "globalalloc",
                        "registersymbol",
                        "unregistersymbol",
                        "dealloc",
                        "address_label"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "lua_lexical"
              },
              "relation": {
                "const": "provides"
              }
            }
          },
          "then": {
            "properties": {
              "locations": {
                "items": {
                  "properties": {
                    "command": {
                      "const": "lua_global_assignment"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "lua_lexical"
              },
              "relation": {
                "const": "requires"
              }
            }
          },
          "then": {
            "properties": {
              "locations": {
                "items": {
                  "properties": {
                    "command": {
                      "const": "lua_global_reference"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
