        i = nl or (#source + 1)
      end
    elseif c == '[' and source:sub(i):match('^%[(=*)%[') then
      local level = source:sub(i):match('^%[(=*)%[')
      local close = ']' .. level .. ']'
      local s_start = i + 2 + #level
      local s_end = source:find(close, s_start, true)
      if not s_end then error('unterminated long string/comment') end
