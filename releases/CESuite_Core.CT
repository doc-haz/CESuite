<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries />
  <UserdefinedSymbols />
  <LuaScript>-- CESuite Core Runtime 0.1.1; generated by tools/build_ce.py
local factories, loaded = {}, {}
factories['aob'] = function(require, api)
local U=require('util')
local M={}
-- Resolve only numbers, enumerated modules and simple +/- constants. No CE symbol
-- lookup: registered callbacks can execute arbitrary table code during lookup.
function M.resolve(expression, modules, defines, seen)
  if type(expression)~='string' then return nil end
  local s=U.trim(expression)
  seen=seen or {}
  if seen[s:lower()] then return nil end
  seen[s:lower()]=true
  if defines and defines[s:lower()]~=nil then
    if not defines[s:lower()] then return nil end
    return M.resolve(defines[s:lower()],modules,defines,seen)
  end
  local n=U.number(s)
  if n then return n end
  local name=U.unquote(s):lower()
  for _,m in ipairs(modules) do
    if m.name:lower()==name and type(m.base)=='string' then return tonumber(m.base:sub(3),16) end
  end
  local base,op,offset=s:match('^(.-)%s*([+-])%s*([%x#xX$]+)$')
  if base then
    local b=M.resolve(base,modules,defines,seen)
    local o=U.number(offset)
    if b and o then local v=b+(op=='+' and o or -o);if v&gt;=0 then return v end end
  end
end
function M.pattern(s)
  if type(s)~='string' then return nil end
  local bytes,known={},false
  for token in s:gmatch('%S+') do
    token=token:gsub('%*','?'):lower()
    if token=='?' then token='??' end
    if #token~=2 or token:find('[^%x?]') then return nil end
    if token:find('%x') then known=true end
    bytes[#bytes+1]=token
  end
  if #bytes==0 or #bytes&gt;4096 or not known then return nil end
  return table.concat(bytes,' ')
end
function M.bounds(a,report,script)
  if a.scope=='process' then return 0,-1 end -- unsigned all-addresses sentinel, no symbol lookup
  if a.scope=='module' then
    local name=U.unquote(a.arguments[2]):lower()
    for _,m in ipairs(report.modules) do
      if m.name:lower()==name and type(m.base)=='string' and type(m.size)=='number' and m.size&gt;0 then
        local base=tonumber(m.base:sub(3),16)
        -- AA passes module base + image size as its stop argument too.
        return base,base+m.size
      end
    end
    return nil,nil,'Module name/size unavailable; scope was not broadened.'
  end
  local first=M.resolve(a.arguments[2],report.modules,script.defines)
  local last=M.resolve(a.arguments[3],report.modules,script.defines)
  if not first or not last or first&gt;last then return nil,nil,'Region expression unresolved or reversed; scope was not broadened.' end
  return first,last
end
local function hookOffset(expr,symbol,defines,seen)
  expr=U.trim(expr);seen=seen or {}
  if seen[expr:lower()] then return nil end
  seen[expr:lower()]=true
  if expr:lower()==symbol:lower() then return 0 end
  if defines[expr:lower()] then return hookOffset(defines[expr:lower()],symbol,defines,seen) end
  local base,sign,num=expr:match('^(.-)%s*([+-])%s*([%x#xX$]+)$')
  if base then
    local b=hookOffset(base,symbol,defines,seen)
    local n=U.number(num)
    if b and n then return b+(sign=='+' and n or -n) end
  end
end
function M.hooks(a,script)
  for _,label in ipairs(script.labels) do
    local offset=hookOffset(label.expression,a.symbol,script.defines)
    if offset then a.hook_candidates[#a.hook_candidates+1]={expression=label.expression,
      line=label.line,offset_bytes=offset,evidence='static_candidate',hook_address=U.null,
      note='AA placement label relative to signature; patch intent and instruction boundary unverified.'} end
  end
  if a.match_count==1 and #a.matches==1 then
    local anchor=tonumber(a.matches[1].signature_anchor:sub(3),16)
    for _,h in ipairs(a.hook_candidates) do if anchor+h.offset_bytes&gt;=0 then h.hook_address=U.hex(anchor+h.offset_bytes) end end
  end
end
function M.validate(api,report,context)
  local scripts,providers={},{}
  for _,s in ipairs(report.scripts) do scripts[s.id]=s end
  for _,a in ipairs(report.aobs) do
    local key=a.script_id..':'..a.symbol:lower()
    providers[key]=(providers[key] or 0)+1
  end
  for _,a in ipairs(report.aobs) do
    local script=scripts[a.script_id]
    local pattern=M.pattern(a.pattern)
    a.observed_at=os.date('!%Y-%m-%dT%H:%M:%SZ')
    local first,last,reason
    if a.syntax_supported then first,last,reason=M.bounds(a,report,script) end
    local pid=U.call(api,'getOpenedProcessID')
    if not report.target.attached or pid~=report.target.pid then a.status='unavailable';reason='No attached process or process changed.'
    elseif not a.syntax_supported or not pattern then a.status='unsupported';reason='Only literal byte/nibble wildcard patterns with correct argument count are supported; all-wildcard scans are refused.'
    elseif first==nil then a.status='unresolved'
    else
      a.scan={start=U.hex(first),stop=type(last)=='string' and '0x'..last or U.hex(last),
        protection_flags='*X*C*W',alignment='none',method='MemScan/FoundList',
        stop_semantics='CE firstScan stop argument; same bounds as AA',error_visibility='unknown'}
      local ms,fl
      local ok,err=xpcall(function()
        ms=assert(api.createMemScan(),'createMemScan failed')
        ms.OnlyOneResult=false
        ms.IsUnique=false
        ms.firstScan(api.soExactValue,api.vtByteArray,api.rtRounded,pattern,'',first,last,
          '*X*C*W',api.fsmNotAligned,'1',true,false,false,false)
        ms.waitTillDone()
        local failure=U.get(ms,'ErrorString')
        a.scan.error_visibility=type(failure)=='string' and 'available' or 'unavailable'
        if type(failure)=='string' and failure~='' then error(failure) end
        fl=assert(api.createFoundList(ms),'createFoundList failed')
        fl.initialize()
        local count=fl.Count
        assert(type(count)=='number' and count&gt;=0,'FoundList count unavailable')
        a.match_count=count
        a.matches_truncated=count&gt;256
        for i=0,math.min(count,256)-1 do
          local address=tonumber(fl.Address[i],16)
          assert(address,'Invalid match address')
          local match={signature_anchor=U.hex(address)}
          if i&lt;8 then match.context=context(api,address,report.target.architecture) end
          a.matches[#a.matches+1]=match
        end
        a.status='observed'
        a.uniqueness=count==1 and 'unique_current_scan' or (count==0 and 'no_match' or 'multiple_matches')
        if a.scan.error_visibility=='unavailable' then
          a.uniqueness='unverified'
          U.warn(report,'SCAN-ERROR-VISIBILITY','CE does not expose scan ErrorString; count is retained but uniqueness is unverified.',a.script_id,a.line)
        end
      end,function(e) return tostring(e) end)
      -- Release only objects created by this scan, found list before its owner.
      if fl then pcall(function() fl.destroy() end) end
      if ms then pcall(function() ms.destroy() end) end
      if not ok then a.status='error';reason=err;a.match_count=U.null;a.uniqueness='unverified';a.matches=U.array();a.matches_truncated=false end
      if U.call(api,'getOpenedProcessID')~=report.target.pid then
        a.status='invalidated';reason='Process changed during scan.';a.uniqueness='unverified';a.match_count=U.null;a.matches=U.array();a.matches_truncated=false
      end
    end
    if reason then a.message=reason end
    if providers[a.script_id..':'..a.symbol:lower()]==1 then M.hooks(a,script)
    else U.warn(report,'AMBIGUOUS-ANCHOR','Repeated AOB symbol in this script; hook inference omitted.',a.script_id,a.line) end
    if a.status=='observed' then
      for i,h in ipairs(a.hook_candidates) do
        if i&lt;=8 and type(h.hook_address)=='string' then h.context=context(api,tonumber(h.hook_address:sub(3),16),report.target.architecture) end
      end
    end
  end
end
return M


end
factories['ct'] = function(require, api)
local U=require('util')
local P=require('parser')
local M={}
function M.capture(api,report,selectedOnly)
  local al,err=U.call(api,'getAddressList')
  report.ct={status='unavailable',selection_only=selectedOnly or false,table_lua_status='unavailable'}
  if not al then U.warn(report,'CT-UNAVAILABLE',err or 'Address list unavailable');return end
  local count=U.get(al,'Count')
  if type(count)~='number' then U.warn(report,'CT-UNAVAILABLE','Address list count unavailable');return end
  local refs,keys,indexKeys={},{},{}
  for i=0,math.min(count,10000)-1 do
    local ok,r=pcall(function() return al.getMemoryRecord(i) end)
    if ok and r then
      refs[#refs+1]=r;keys[r]='record-'..(i+1)
      local index=U.get(r,'Index');if type(index)=='number' then indexKeys[index]=keys[r] end
    else U.warn(report,'RECORD-UNAVAILABLE','Could not read MemoryRecord index '..i) end
  end
  if count&gt;10000 then U.warn(report,'CT-LIMIT','Inventory limited to 10000 records.') end
  local selected=U.get(al,'SelectedRecord')
  local selectedIndex=selected and U.get(selected,'Index')
  if api.vtAutoAssembler==nil then U.warn(report,'AA-TYPE-UNAVAILABLE','vtAutoAssembler constant unavailable; AA script extraction cannot be classified.') end
  local function addScript(text,language,key,origin)
    local s={id='script-'..(#report.scripts+1),language=language,text=text,record_key=key or U.null,origin=origin}
    report.scripts[#report.scripts+1]=s
    if language=='AA' then P.inspect(s,report) end
    return s.id
  end
  for _,r in ipairs(refs) do
    if not selectedOnly or r==selected or (selectedIndex~=nil and U.get(r,'Index')==selectedIndex) then
      local parent=U.get(r,'Parent')
      local parentKey=parent and (indexKeys[U.get(parent,'Index')] or keys[parent])
      local row={key=keys[r],id=U.get(r,'ID') or U.null,parent_key=parentKey or U.null,
        description=U.get(r,'Description') or '',address=U.get(r,'Address') or U.null,
        variable_type=U.get(r,'Type') or U.null,active=U.get(r,'Active')==true,scripts=U.array(),offsets=U.array()}
      for j=0,(U.get(r,'OffsetCount') or 0)-1 do
        local ok,offset=pcall(function() return r.OffsetText[j] end)
        row.offsets[#row.offsets+1]=ok and tostring(offset) or 'unavailable'
      end
      if api.vtAutoAssembler~=nil and row.variable_type==api.vtAutoAssembler then
        local source=U.get(r,'Script')
        if type(source)=='string' then row.scripts[#row.scripts+1]=addScript(source,'AA',row.key,'MemoryRecord.Script')
        else U.warn(report,'SCRIPT-UNAVAILABLE','MemoryRecord.Script unavailable',nil) end
      end
      report.records[#report.records+1]=row
      if row.active then U.warn(report,'ACTIVE-RECORD','Active record observed; bytes/signatures may already be modified by the loaded table.',nil) end
    end
  end
  if selectedOnly and not selected then U.warn(report,'SELECTION-EMPTY','Select an AA MemoryRecord first.') end
  -- Read the documented editor property, never execute it or serialize the table.
  if not selectedOnly then
    local ok,text=pcall(function() return api.getLuaEngine().mScript.Lines.Text end)
    if ok and type(text)=='string' then
      addScript(text,'Lua',nil,'LuaEngine.mScript.Lines.Text')
      report.ct.table_lua_status='editor_snapshot'
    else U.warn(report,'TABLE-LUA-UNAVAILABLE','Table Lua editor unavailable; globals, closures and external files are not introspected.') end
  end
  report.ct.status='captured'
  report.ct.loaded_table_version=U.get(al,'LoadedTableVersion') or U.null
  for _,s in ipairs(report.scripts) do
    if s.language=='Lua' then
      for _,hint in ipairs({{'createTimer','TIMER-LIFECYCLE'}, {'debug_setBreakpoint','BREAKPOINT-OWNERSHIP'},
        {'debugger_onBreakpoint','HANDLER-CHAIN'}}) do
        if s.text:find(hint[1],1,true) then U.warn(report,hint[2],
          'Lexical Lua candidate (comments/strings may match); review resource ownership and callback teardown.',s.id) end
      end
    end
  end
end
return M


end
factories['disassembly'] = function(require, api)
local U=require('util')
local M={}
-- CE does not document a universal RIP-relative flag. Recognize only selected
-- legacy one-byte opcodes whose ModRM position is known; all others stay unknown.
function M.rip(bytes,arch)
  if arch=='x86' then return 'not_applicable' end
  if arch~='x64' then return 'unknown' end
  local i,addressOverride=1,false
  while bytes[i] do
    local b=bytes[i]
    if b==0x67 then addressOverride=true;i=i+1
    elseif b==0x66 or b==0xF0 or b==0xF2 or b==0xF3 or b==0x2E or b==0x36 or b==0x3E or b==0x26 or b==0x64 or b==0x65 or (b&gt;=0x40 and b&lt;=0x4F) then i=i+1
    else break end
  end
  local op=bytes[i]
  local known={[0x8B]=true,[0x89]=true,[0x8D]=true,[0x8A]=true,[0x88]=true,[0xFF]=true,[0xC7]=true,[0xC6]=true,
    [0x01]=true,[0x03]=true,[0x29]=true,[0x2B]=true,[0x39]=true,[0x3B]=true,[0x85]=true}
  local modrm=bytes[i+1]
  if not known[op] or not modrm then return 'unknown' end
  if addressOverride then return 'not_rip_relative' end
  return modrm&lt;0x40 and modrm%8==5 and 'rip_relative' or 'not_rip_relative'
end
function M.capture(api,address,arch)
  local result={address=U.hex(address),boundary='unverified_candidate',bytes=U.array(),instructions=U.array(),status='partial'}
  result.bytes_start=U.hex(math.max(0,address-16));result.bytes_requested=48
  local bytes,err=U.call(api,'readBytes',math.max(0,address-16),48,true)
  if type(bytes)=='table' then result.bytes=U.array(bytes) else result.read_error=err or 'Bytes unavailable' end
  local d
  local ok,failure=xpcall(function()
    d=assert(api.createDisassembler(),'Disassembler unavailable')
    local cursor=address
    for _=1,8 do
      local text=d.disassemble(cursor)
      local data=d.getLastDisassembleData()
      assert(type(data)=='table' and type(data.bytes)=='table' and #data.bytes&gt;0,'Instruction metadata unavailable')
      local ins={address=U.hex(cursor),text=text or '',opcode=data.opcode or '',parameters=data.parameters or '',
        bytes=U.array(data.bytes),length=#data.bytes,branch='unknown',rip_relative=M.rip(data.bytes,arch),
        classification='CE metadata and limited byte decoder; not relocation validation'}
      if data.isCall then ins.branch='call'
      elseif data.isRet then ins.branch='return'
      elseif data.isConditionalJump then ins.branch='conditional_jump'
      elseif data.isJump then ins.branch='jump'
      elseif data.isJump==false and data.isCall==false and data.isRet==false then ins.branch='none' end
      if data.parameterValueType==1 then ins.parameter_address=U.hex(data.parameterValue) end
      if data.modrmValueType==1 then ins.memory_operand_address=U.hex(data.modrmValue) end
      result.instructions[#result.instructions+1]=ins
      cursor=cursor+#data.bytes
    end
    result.status=#result.bytes==48 and 'captured' or 'partial'
  end,function(e) return tostring(e) end)
  if d then pcall(function() d.destroy() end) end
  if not ok then result.disassembly_error=failure end
  return result
end
return M


end
factories['environment'] = function(require, api)
local U = require('util')
local M = {}
function M.capture(api, report)
  local pid, err = U.call(api, 'getOpenedProcessID')
  local target = {pid=pid or U.null, attached=type(pid)=='number' and pid&gt;0,
    name=type(api.process)=='string' and api.process or U.null, architecture='unknown',
    build_fingerprint=U.null}
  report.target=target
  report.modules=U.array()
  report.ce_version=tostring(U.call(api, 'getCEVersion') or 'unknown')
  if not target.attached then
    U.warn(report,'PROCESS-UNAVAILABLE',err or 'No process attached; no runtime reads or scans.')
    return
  end
  local x64=U.call(api,'targetIs64Bit')
  if type(x64)=='boolean' then target.architecture=x64 and 'x64' or 'x86' end
  local modules, failure=U.call(api,'enumModules')
  if type(modules)~='table' then U.warn(report,'MODULES-UNAVAILABLE',failure or 'Module enumeration failed'); return end
  for _,m in ipairs(modules) do
    local size=U.call(api,'getModuleSize',m.Name)
    table.insert(report.modules,{name=m.Name,base=U.hex(m.Address),size=type(size)=='number' and size or U.null,
      path=m.PathToFile or U.null,architecture=m.Is64Bit==nil and 'unknown' or (m.Is64Bit and 'x64' or 'x86')})
  end
end
return M


end
factories['exporter'] = function(require, api)
local U=require('util')
local M={}
local function quote(s)
  -- CE text is expected to be UTF-8; reject malformed input instead of writing invalid JSON.
  if utf8 and not utf8.len(s) then error('Invalid UTF-8 in report text') end
  return '"'..s:gsub('[%z\1-\31\\"]',function(c)
    local escapes={['"']='\\"',['\\']='\\\\',['\n']='\\n',['\r']='\\r',['\t']='\\t'}
    return escapes[c] or string.format('\\u%04x',c:byte())
  end)..'"'
end
function M.encode(value,seen)
  if value==U.null then return 'null' end
  local t=type(value)
  if t=='string' then return quote(value) end
  if t=='boolean' then return tostring(value) end
  if t=='number' then assert(value==value and math.abs(value)~=math.huge,'Non-finite number');return tostring(value) end
  assert(t=='table','Unsupported JSON value: '..t)
  seen=seen or {};assert(not seen[value],'Cyclic JSON value');seen[value]=true
  local parts={}
  if (getmetatable(value) or {}).__json_array then
    for i=1,#value do parts[#parts+1]=M.encode(value[i],seen) end
    seen[value]=nil;return '['..table.concat(parts,',')..']'
  end
  local keys={};for k in pairs(value) do assert(type(k)=='string','JSON object key must be string');keys[#keys+1]=k end
  table.sort(keys)
  for _,k in ipairs(keys) do parts[#parts+1]=quote(k)..':'..M.encode(value[k],seen) end
  seen[value]=nil;return '{'..table.concat(parts,',')..'}'
end
function M.write(report,path)
  local encoded=M.encode(report)..'\n'
  local f,err=io.open(path,'wb');assert(f,err)
  local ok,failure=f:write(encoded)
  local closed,closeError=f:close()
  assert(ok,failure);assert(closed,closeError)
  return path
end
return M


end
factories['lifecycle'] = function(require, api)
local M={}
function M.new()
  local state={owned={},busy=false}
  function state.own(object) state.owned[#state.owned+1]=object;return object end
  function state.shutdown()
    assert(not state.busy,'CESuite is busy')
    for i=#state.owned,1,-1 do pcall(function() state.owned[i].destroy() end) end
    state.owned={}
  end
  function state.run(callback)
    assert(not state.busy,'CESuite is already analyzing')
    state.busy=true
    local ok,result=xpcall(callback,function(e) return tostring(e) end)
    state.busy=false
    if not ok then error(result) end
    return result
  end
  return state
end
return M


end
factories['parser'] = function(require, api)
-- Conservative lexical AA inventory. Never compiles AA or evaluates Lua/expressions.
local U=require('util')
local M={}
function M.arguments(s)
  local out, start, depth, quote=U.array(),1,0,nil
  for i=1,#s do
    local c=s:sub(i,i)
    if quote then if c==quote then quote=nil end
    elseif c=='"' or c=="'" then quote=c
    elseif c=='(' then depth=depth+1
    elseif c==')' then depth=depth-1
    elseif c==',' and depth==0 then out[#out+1]=U.trim(s:sub(start,i-1));start=i+1 end
  end
  out[#out+1]=U.trim(s:sub(start))
  return out
end
function M.lines(source)
  local out, lua, block, cblock=U.array(),false,false,false
  local n=0
  for raw in (source..'\n'):gmatch('(.-)\n') do
    n=n+1
    local trimmed=U.trim(raw):lower()
    if not block and not cblock and trimmed=='{$lua}' then lua=true;out[#out+1]={line=n,text='',directive='lua'}
    elseif lua and trimmed=='{$asm}' then lua=false;out[#out+1]={line=n,text='',directive='asm'}
    elseif lua then out[#out+1]={line=n,text='',lua=raw}
    else
      local clean,quote,i='',nil,1
      while i&lt;=#raw do
        local c,pair=raw:sub(i,i),raw:sub(i,i+1)
        if block then if c=='}' then block=false end
        elseif cblock then if pair=='*/' then cblock=false;i=i+1 end
        elseif quote then clean=clean..c;if c==quote then quote=nil end
        elseif c=='"' or c=="'" then quote=c;clean=clean..c
        elseif pair=='//' then break
        elseif pair=='/*' then cblock=true;i=i+1
        elseif c=='{' then
          if raw:sub(i,i+1)=='{$' then clean=clean..raw:sub(i);break end
          block=true
        else clean=clean..c end
        i=i+1
      end
      out[#out+1]={line=n,text=U.trim(clean)}
    end
  end
  return out
end
local scopes={aobscan='process',aobscanmodule='module',aobscanregion='region'}
local counts={aobscan=2,aobscanmodule=3,aobscanregion=4}
function M.inspect(script, report)
  local section, disable, disableContent='common',false,false
  local lines=M.lines(script.text)
  script.labels=U.array();script.defines={};script.dynamic=false
  local luaText,luaLine={},nil
  local function flushLua()
    if luaLine then report.scripts[#report.scripts+1]={id=script.id..'-lua-'..luaLine,
      language='Lua',text=table.concat(luaText,'\n'),origin='embedded',parent_script_id=script.id,
      record_key=script.record_key,line=luaLine};luaText={};luaLine=nil end
  end
  for _,row in ipairs(lines) do
    local s=row.text
    if row.directive=='lua' then script.dynamic=true;luaLine=row.line+1;if section=='disable' then disableContent=true end
    elseif row.lua then luaText[#luaText+1]=row.lua
    elseif row.directive=='asm' then flushLua()
    elseif s:upper()=='[ENABLE]' then section='enable'
    elseif s:upper()=='[DISABLE]' then section='disable';disable=true
    elseif s~='' then
      if section=='disable' then disableContent=true end
      local cmd,raw=s:match('^([%w_]+)%s*%((.*)%)%s*$')
      cmd=cmd and cmd:lower()
      local args=raw and M.arguments(raw)
      if scopes[cmd] then
        local id='aob-'..(#report.aobs+1)
        report.aobs[#report.aobs+1]={id=id,script_id=script.id,line=row.line,section=section,
          command=cmd,arguments=args,symbol=args[1],scope=scopes[cmd],pattern=args[#args],
          syntax_supported=#args==counts[cmd],status='not_scanned',match_count=U.null,
          uniqueness='unverified',cross_build_robustness='unverified',matches=U.array(),
          matches_truncated=false,hook_candidates=U.array(),source_applicability='lexical_only'}
      elseif cmd=='define' and #args==2 and section~='disable' then
        local key=args[1]:lower()
        if script.defines[key]~=nil then script.defines[key]=false else script.defines[key]=args[2] end
      elseif cmd=='alloc' or cmd=='globalalloc' or cmd=='dealloc' or cmd=='registersymbol' or cmd=='unregistersymbol' then
        report.resources[#report.resources+1]={script_id=script.id,line=row.line,section=section,
          command=cmd,arguments=args,ownership='unverified',lifecycle='unverified'}
        if cmd=='dealloc' then U.warn(report,'RESTORE-BEFORE-FREE','Review full byte restoration and in-flight execution before free; lexical order is not proof.',script.id,row.line) end
        if (cmd=='dealloc' or cmd=='unregistersymbol') and (raw=='' or raw:find('*',1,true)) then
          U.warn(report,'RESOURCE-OWNERSHIP','Broad cleanup candidate; ownership is unverified.',script.id,row.line)
        end
      elseif cmd=='include' or cmd=='luacall' or s:find('{$',1,true) then script.dynamic=true end
      local label=s:match('^(.-):$')
      if label and section~='disable' then script.labels[#script.labels+1]={expression=U.trim(label),line=row.line} end
    end
  end
  flushLua()
  if disable and not disableContent then U.warn(report,'EMPTY-DISABLE','Empty DISABLE may intentionally keep a persistent library installed.',script.id) end
  if script.dynamic then U.warn(report,'DYNAMIC-SOURCE','Lua/includes/preprocessor may change AA. Literal scans are lexical observations, not compiled-script equivalence.',script.id) end
end
return M


end
factories['ui'] = function(require, api)
local Export=require('exporter')
local M={}
function M.showReport(Core,api,report)
  if not Core.viewer then
    Core.viewer=Core.state.own(api.createForm(false))
    Core.viewer.Caption='CESuite observation report'
    Core.viewer.Width=900;Core.viewer.Height=650
    Core.memo=api.createMemo(Core.viewer)
    Core.memo.Parent=Core.viewer;Core.memo.Align='alClient'
    Core.memo.ReadOnly=true;Core.memo.ScrollBars='ssBoth';Core.memo.WordWrap=false
  end
  Core.memo.Lines.Text=Export.encode(report)
  Core.viewer.show()
end
function M.install(Core,api)
  local parent=api.getMainForm().Menu
  for i=0,(parent.Items.Count or 0)-1 do
    assert(parent.Items[i].Name~='CESuiteCoreMenu','CESuite menu already exists; restart CE')
  end
  local menu=Core.state.own(api.createMenuItem(parent));menu.Caption='CESuite';menu.Name='CESuiteCoreMenu'
  parent.Items.add(menu)
  local function command(caption,callback)
    local item=api.createMenuItem(menu);item.Caption=caption
    item.OnClick=function()
      local ok,result=pcall(callback)
      if not ok then api.showMessage('CESuite: '..tostring(result)) end
    end
    menu.add(item)
  end
  local function inspect(mode)
    local r=Core.analyze(mode)
    Core.showReport(r)
  end
  command('Analyze Current Process',function() inspect('process') end)
  command('Analyze Loaded Table',function() inspect('table') end)
  command('Validate AOBs',function() inspect('validate') end)
  command('Inspect Selected Script',function() inspect('selected') end)
  command('Export ChatGPT Report',function()
    local dialog=api.createSaveDialog(api.getMainForm())
    local ok,err=pcall(function()
      dialog.FileName='CESuite_Runtime_Report.json';dialog.DefaultExt='json';dialog.Filter='JSON report|*.json'
      dialog.Options='[ofOverwritePrompt,ofPathMustExist]'
      if dialog.execute() then Core.export(dialog.FileName);api.showMessage('CESuite report saved: '..dialog.FileName) end
    end)
    dialog.destroy()
    if not ok then error(err) end
  end)
  command('About CESuite',function() api.showMessage('CESuite '..Core.version..' | '..Core.status..' | '..tostring(Core.distribution)) end)
  command('Remove CESuite Menu',function() Core.shutdown() end)
end
return M

end
factories['util'] = function(require, api)
local M = {}
M.null = setmetatable({}, {__json_null = true})
function M.array(t) return setmetatable(t or {}, {__json_array = true}) end
function M.trim(s) return (s:gsub('^%s+', ''):gsub('%s+$', '')) end
function M.hex(n) return type(n) == 'number' and string.format('0x%X', n) or M.null end
function M.get(obj, key)
  local ok, value = pcall(function() return obj[key] end)
  if ok then return value end
end
function M.call(api, name, ...)
  if type(api[name]) ~= 'function' then return nil, name .. ' unavailable' end
  local ok, value = pcall(api[name], ...)
  if ok then return value end
  return nil, tostring(value)
end
function M.warn(report, rule, message, script, line)
  table.insert(report.diagnostics, {rule=rule, severity='review', evidence='unverified',
    message=message, script_id=script or M.null, line=line or M.null})
end
function M.number(s)
  s = M.trim(s)
  if s:match('^#%d+$') then return tonumber(s:sub(2), 10) end
  if s:match('^0[xX]%x+$') then return tonumber(s:sub(3), 16) end
  if s:match('^%$%x+$') then return tonumber(s:sub(2), 16) end
  if s:match('^%x+$') then return tonumber(s, 16) end
end
function M.unquote(s)
  local a,b=s:sub(1,1),s:sub(-1)
  if (a=='"' or a=="'") and a==b then return s:sub(2,-2) end
  return s
end
return M


end
local api = _G
local function requireModule(name)
  if loaded[name] then return loaded[name] end
  assert(factories[name], 'Unknown CESuite module: '..name)
  loaded[name] = factories[name](requireModule, api)
  return loaded[name]
end
local function entry(require, api)

-- Entry point receives a private module loader and the CE API from the bundle.
local U=require('util')
local Env=require('environment')
local CT=require('ct')
local AOB=require('aob')
local Disasm=require('disassembly')
local Export=require('exporter')
local Life=require('lifecycle')
local UI=require('ui')
local Core={identity='CESuiteCore',version='0.1.1',schema_version='0.1',status='stopped',state=Life.new()}
function Core.analyze(mode)
  return Core.state.run(function()
    local r={schema_version=Core.schema_version,core_version=Core.version,
      generated_at=os.date('!%Y-%m-%dT%H:%M:%SZ'),mode=mode,observation_only=true,
      records=U.array(),scripts=U.array(),aobs=U.array(),resources=U.array(),diagnostics=U.array(),
      limitations=U.array({'Not an atomic process snapshot; target memory and modules may change during collection.',
        'Uniqueness applies only to CE-readable memory in this scan, not other builds or hook compatibility.',
        'No source scripts, symbol callbacks, includes or macros are executed. Computed expressions can remain unresolved.',
        'Up to 256 addresses per AOB; context for first 8 matches and first 8 resolved hook candidates.',
        'Instruction boundaries, ownership, restore-before-free, overwrite length and relocation safety remain unverified.',
        'CE scan memory-type preferences and unreadable pages can limit coverage; no complete address-space accessibility claim.',
        'Table Lua is an editor snapshot; external Lua files, closures and arbitrary globals are not captured.'})}
    Env.capture(api,r)
    if mode~='process' then CT.capture(api,r,mode=='selected') end
    if mode=='validate' or mode=='export' then AOB.validate(api,r,Disasm.capture) end
    r.completed_at=os.date('!%Y-%m-%dT%H:%M:%SZ')
    if U.call(api,'getOpenedProcessID')~=r.target.pid then
      U.warn(r,'PROCESS-CHANGED','Process changed during collection; runtime results invalidated.')
      for _,a in ipairs(r.aobs) do a.status='invalidated';a.uniqueness='unverified';a.match_count=U.null;a.matches=U.array();a.hook_candidates=U.array();a.matches_truncated=false end
    end
    Core.last_report=r
    return r
  end)
end
function Core.export(path) return Export.write(Core.analyze('export'),path) end
function Core.shutdown() Core.state.shutdown();Core.viewer=nil;Core.memo=nil;Core.status='stopped' end
function Core.showReport(report) return UI.showReport(Core,api,report) end
function Core.install()
  if Core.status=='ready' then return Core end
  assert(Core.status~='loading','CESuite menu is already loading')
  Core.status='loading'
  local ok,err=pcall(UI.install,Core,api)
  if not ok then Core.shutdown();error(err) end
  Core.status='ready'
  return Core
end
return Core

end
local version='0.1.1'
local mode='portable'
local function factory() return entry(requireModule,api) end
-- Shared by both distributions. Dependencies are private to each new instance.
local function notify(message)
  if type(api.showMessage)=='function' then pcall(api.showMessage,message)
  elseif type(api.print)=='function' then pcall(api.print,message) end
end
local existing=rawget(api,'CESuiteCore')
if existing~=nil then
  if type(existing)~='table' or existing.identity~='CESuiteCore' then
    local err='CESuiteCore is already occupied (possibly an older Core). Restart CE before upgrading.'
    notify(err);return nil,err
  end
  if existing.version~=version then
    local err='CESuite '..tostring(existing.version)..' is already loaded; requested '..version..'. Restart CE to change versions.'
    notify(err);return existing,err
  end
  local ok,err=pcall(existing.install)
  if not ok then notify('CESuite: '..tostring(err));return nil,err end
  return existing
end
if rawget(api,'CESuiteLoading') then return nil,'CESuite is already loading' end
api.CESuiteLoading=true
local core
local ok,err=pcall(function()
  core=factory()
  assert(core.version==version,'CESuite package version mismatch')
  core.distribution=mode
  core.install()
  api.CESuiteCore=core
end)
api.CESuiteLoading=nil
if not ok then
  if core then pcall(core.shutdown) end
  notify('CESuite failed to load: '..tostring(err))
  return nil,err
end
return core
</LuaScript>
</CheatTable>
