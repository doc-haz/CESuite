        protection_flags='*X*C*W',alignment='none',method='MemScan/FoundList',
        stop_semantics='CE firstScan stop argument; same bounds as AA',error_visibility='unknown'}
      local ms,fl
      attempted=attempted+1
      local ok,err=xpcall(function()
        ms=assert(api.createMemScan(),'createMemScan failed')
        ms.OnlyOneResult=false
        ms.IsUnique=false
        ms.firstScan(api.soExactValue,api.vtByteArray,api.rtRounded,pattern,'',first,last,
          '*X*C*W',api.fsmNotAligned,'1',true,false,false,false)
        ms.waitTillDone()
        local failure=U.get(ms,'ErrorString')
        a.scan.error_visibility=type(failure)=='string' and 'available' or 'unavailable'
        if type(failure)=='string' and failure~='' then error(failure) end
        fl=assert(api.createFoundList(ms),'createFoundList failed')
        fl.initialize()
        local count=fl.Count
        assert(type(count)=='number' and count&gt;=0,'FoundList count unavailable')
        a.match_count=count
        a.matches_truncated=count&gt;256
        for i=0,math.min(count,256)-1 do
          local address=tonumber(fl.Address[i],16)
          assert(address,'Invalid match address')
          local match={signature_anchor=U.hex(address)}
          if context and i&lt;8 then match.context=context(api,address,report.target.architecture) end
          a.matches[#a.matches+1]=match
        end
        a.status='observed'
        a.uniqueness=count==1 and 'unique_current_scan' or (count==0 and 'no_match' or 'multiple_matches')
        completed=completed+1
        if a.matches_truncated then truncated=true end
        if a.scan.error_visibility=='unavailable' then
          a.uniqueness='unverified'
          U.warn(report,'SCAN-ERROR-VISIBILITY','CE does not expose scan ErrorString; count is retained but uniqueness is unverified.',a.script_id,a.line)
        end
      end,function(e) return tostring(e) end)
      -- Release only objects created by this scan, found list before its owner.
      if fl then pcall(function() fl.destroy() end) end
      if ms then pcall(function() ms.destroy() end) end
      if not ok then a.status='error';reason=err;a.match_count=U.null;a.uniqueness='unverified';a.matches=U.array();a.matches_truncated=false end
      if U.call(api,'getOpenedProcessID')~=report.target.pid then
        a.status='invalidated';reason='Process changed during scan.';a.uniqueness='unverified';a.match_count=U.null;a.matches=U.array();a.matches_truncated=false
      end
    end
    if reason then a.message=reason end
    if providers[a.script_id..':'..a.symbol:lower()]==1 then M.hooks(a,script)
    else U.warn(report,'AMBIGUOUS-ANCHOR','Repeated AOB symbol in this script; hook inference omitted.',a.script_id,a.line) end
    if a.status=='observed' then
      for i,h in ipairs(a.hook_candidates) do
        if context and i&lt;=8 and type(h.hook_address)=='string' then h.context=context(api,tonumber(h.hook_address:sub(3),16),report.target.architecture) end
      end
    end
  end
  return {attempted=attempted,completed=completed,truncated=truncated}
end
return M

end
factories['coverage'] = function(require, api)
-- Coverage model (030C): collection, discovery and validation are separate
-- dimensions. Static analysis never promotes candidates to runtime validation.
local U=require('util')
local M={}

local function count_limits(dynamic)
  local codes={}
  for _,entry in ipairs(dynamic and dynamic.unresolved or {}) do
    if type(entry.code)=='string' and entry.code:match('_LIMIT$') then
      codes[entry.code]=(codes[entry.code] or 0)+1
    end
  end
  local list=U.array()
  for code,count in pairs(codes) do
    list[#list+1]={code=code,count=count}
  end
  table.sort(list,function(a,b) return a.code&lt;b.code end)
  return list
end

local function percentage(numerator,denominator,known)
  if not known or type(denominator)~='number' or denominator&lt;=0 then return U.null end
  if type(numerator)~='number' then return U.null end
  return math.floor((numerator/denominator)*1000+0.5)/10
end

function M.collection(scripts, dynamic, opts)
  opts=opts or {}
  local units=#(scripts or {})
  local limits=count_limits(dynamic)
  local limited=#limits&gt;0 or (dynamic and dynamic.status=='limit_reached')
  local complete = not limited
  local status
  if units==0 then status=limited and 'limit_reached' or 'complete'
  elseif limited then status='limit_reached'
  else status='complete' end
  local limitations=U.array()
  for _,item in ipairs(limits) do
    limitations[#limitations+1]=item.code..' reached during collection'
  end
  if dynamic and dynamic.status=='limit_reached' and #limitations==0 then
    limitations[#limitations+1]='dynamic parser reached a structural limit'
  end
  return {
    scope='captured_scripts_and_embedded_lua',
    units_discovered=units,
    units_processed=units,
    complete=complete,
    universe_known=true,
    denominator='captured_units',
    status=status,
    percentage=percentage(units,units,true),
    limitations=limitations
  }
end

function M.discovery(dynamic, opts)
  opts=opts or {}
  local counts=dynamic and dynamic.counts or {}
  local literal=counts.literal or 0
  local derived=counts.derived or 0
  local conditional=counts.conditional or 0
  local symbol_only=counts.symbol_only or 0
  local specs=counts.specs or (literal+derived+symbol_only)
  local candidates=counts.candidates or (literal+derived)
  local unresolved=0
  local unsupported=0
  local linked=0
  for _,candidate in ipairs(dynamic and dynamic.patterns or {}) do
    if candidate.status=='candidate' then linked=linked+1
    elseif candidate.status=='unresolved' then unresolved=unresolved+1
    elseif candidate.status=='unsupported' then unsupported=unsupported+1 end
  end
  for _,entry in ipairs(dynamic and dynamic.unresolved or {}) do
    if entry.code~='TABLE_LIMIT' and entry.code~='PARSE_LIMIT'
      and entry.code~='EDGE_LIMIT' and entry.code~='CANDIDATE_LIMIT'
      and entry.code~='CONDITIONAL_DEPENDENCY' then
      unresolved=unresolved+1
    end
  end
  local limited=dynamic and dynamic.status=='limit_reached'
  local universe_known=opts.universe_known==true
  local complete=universe_known and not limited and unresolved==0 and unsupported==0
  local status
  if limited then status='limit_reached'
  elseif universe_known and unresolved==0 and unsupported==0 then status='complete'
  elseif unresolved&gt;0 or unsupported&gt;0 then status='partial'
  else status='unknown' end
  local limitations=U.array()
  if not universe_known then
    limitations[#limitations+1]='The total number of patterns in uncaptured source is unknown.'
  end
  if unresolved&gt;0 then limitations[#limitations+1]='Some candidates remain unresolved.' end
  if limited then limitations[#limitations+1]='Discovery stopped at a structural limit.' end
  return {
    patterns_discovered=literal+derived+conditional,
    patterns_literal=literal,
    patterns_derived=derived,
    patterns_conditional=conditional,
    patterns_symbol_only=symbol_only,
    entities_discovered=specs,
    candidates=candidates,
    linked=linked,
    unresolved=unresolved,
    unsupported=unsupported,
    complete=complete,
    universe_known=universe_known,
    denominator='discovered_entities',
    status=status,
    percentage=percentage(linked,specs,universe_known),
    limitations=limitations
  }
end

local function aob_counts(aobs)
  local c={attempted=0,validated=0,unique=0,ambiguous=0,no_match=0,error=0,
    unavailable=0,unresolved=0,unsupported=0}
  for _,aob in ipairs(aobs or {}) do
    local status=aob.status
    if status=='observed' then
      c.attempted=c.attempted+1
      local count=aob.match_count
      local uniqueness=aob.uniqueness
      if count==1 and uniqueness=='unique_current_scan' then
        c.validated=c.validated+1;c.unique=c.unique+1
      elseif (type(count)=='number' and count&gt;1) or uniqueness=='multiple_matches' then
        c.ambiguous=c.ambiguous+1
      elseif count==0 or uniqueness=='no_match' then
        c.no_match=c.no_match+1
      else
        c.no_match=c.no_match+1
      end
    elseif status=='error' then c.attempted=c.attempted+1;c.error=c.error+1
    elseif status=='invalidated' then c.attempted=c.attempted+1;c.unavailable=c.unavailable+1
    elseif status=='unavailable' then c.unavailable=c.unavailable+1
    elseif status=='unsupported' then c.unsupported=c.unsupported+1
    elseif status=='unresolved' then c.unresolved=c.unresolved+1
    end
  end
  return c
end

function M.validation(discovery, aobs, opts)
  opts=opts or {}
  local c=aob_counts(aobs)
  local candidates=discovery.candidates or 0
  local universe_known=(opts.universe_known==true) and (discovery.unresolved==0)
  local status
  if candidates==0 then status='not_applicable'
  elseif c.attempted==0 then status='unavailable'
  elseif c.attempted&lt;candidates or c.error&gt;0 or not universe_known then status='partial'
  else status='complete' end
  local complete=(candidates&gt;0 and c.attempted&gt;=candidates and c.error==0 and universe_known)
  local limitations=U.array()
  if candidates==0 then limitations[#limitations+1]='No validation candidates were discovered.' end
  if c.attempted==0 and candidates&gt;0 then
    limitations[#limitations+1]='No runtime scan was attempted for the discovered candidates.'
  end
  if not universe_known and candidates&gt;0 then
    limitations[#limitations+1]='Validation universe is unknown; no percentage is claimed.'
  end
  return {
    candidates=candidates,
    runtime_attempted=c.attempted,
    runtime_validated=c.validated,
    runtime_unique=c.unique,
    runtime_ambiguous=c.ambiguous,
    runtime_no_match=c.no_match,
    runtime_error=c.error,
    runtime_unavailable=c.unavailable,
    unresolved=discovery.unresolved+c.unresolved,
    unsupported=discovery.unsupported+c.unsupported,
    complete=complete,
    universe_known=universe_known,
    denominator='validation_candidates',
    status=status,
    percentage=percentage(c.validated,candidates,universe_known),
    limitations=limitations
  }
end

function M.for_static(dynamic, scripts, opts)
  local collection=M.collection(scripts,dynamic,opts)
  local discovery=M.discovery(dynamic,opts)
  local validation=M.validation(discovery,nil,opts)
  return {collection=collection,discovery=discovery,validation=validation}
end

function M.for_runtime(report, dynamic, opts)
  local collection=M.collection(report and report.scripts or {},dynamic,opts)
  local discovery=M.discovery(dynamic,opts)
  local validation=M.validation(discovery,report and report.aobs or {},opts)
  return {collection=collection,discovery=discovery,validation=validation}
end

function M.summaryText(cov)
  if not cov or type(cov)~='table' then return 'Coverage Summary\n\nNo coverage data available.' end
  local coll=cov.collection or {}
  local disc=cov.discovery or {}
  local val=cov.validation or {}
  local lines={
    'Coverage Summary',
    '',
    'Collection',
    string.format('  Status: %s',tostring(coll.status or 'unknown')),
    string.format('  Processed: %d / %d',coll.units_processed or 0,coll.units_discovered or 0),
    '',
    'Discovery',
    string.format('  Status: %s',tostring(disc.status or 'unknown')),
    string.format('  Entities: %d',disc.entities_discovered or 0),
    string.format('  Candidates: %d',disc.candidates or 0),
    string.format('  Linked: %d',disc.linked or 0),
    '',
    'Validation',
    string.format('  Status: %s',tostring(val.status or 'unknown')),
    string.format('  Attempted: %d / %d',val.runtime_attempted or 0,val.candidates or 0),
    string.format('  Validated: %d',val.runtime_validated or 0)
  }
  return table.concat(lines,'\n')
end

return M

end
factories['ct'] = function(require, api)
local U=require('util')
local P=require('parser')
local M={}
function M.capture(api,report,selectedOnly)
  local al,err=U.call(api,'getAddressList')
  report.ct={status='unavailable',selection_only=selectedOnly or false,table_lua_status='unavailable'}
  if not al then U.warn(report,'CT-UNAVAILABLE',err or 'Address list unavailable');return end
  local count=U.get(al,'Count')
  if type(count)~='number' then U.warn(report,'CT-UNAVAILABLE','Address list count unavailable');return end
  local refs,keys,indexKeys={},{},{}
  for i=0,math.min(count,10000)-1 do
    local ok,r=pcall(function() return al.getMemoryRecord(i) end)
    if ok and r then
      refs[#refs+1]=r;keys[r]='record-'..(i+1)
      local index=U.get(r,'Index');if type(index)=='number' then indexKeys[index]=keys[r] end
    else U.warn(report,'RECORD-UNAVAILABLE','Could not read MemoryRecord index '..i) end
  end
  if count&gt;10000 then U.warn(report,'CT-LIMIT','Inventory limited to 10000 records.') end
  local selected=U.get(al,'SelectedRecord')
  local selectedIndex=selected and U.get(selected,'Index')
  if api.vtAutoAssembler==nil then U.warn(report,'AA-TYPE-UNAVAILABLE','vtAutoAssembler constant unavailable; AA script extraction cannot be classified.') end
  local function addScript(text,language,key,origin)
    local s={id='script-'..(#report.scripts+1),language=language,text=text,record_key=key or U.null,origin=origin}
    report.scripts[#report.scripts+1]=s
    if language=='AA' then P.inspect(s,report) end
    return s.id
  end
  for _,r in ipairs(refs) do
    if not selectedOnly or r==selected or (selectedIndex~=nil and U.get(r,'Index')==selectedIndex) then
      local parent=U.get(r,'Parent')
      local parentKey=parent and (indexKeys[U.get(parent,'Index')] or keys[parent])
      -- Address can evaluate dynamic offsets and execute Lua, even inside pcall.
      -- Keep the nullable report field without resolving it during passive capture.
      local row={key=keys[r],id=U.get(r,'ID') or U.null,parent_key=parentKey or U.null,
        description=U.get(r,'Description') or '',address=U.null,
        variable_type=U.get(r,'Type') or U.null,active=U.get(r,'Active')==true,scripts=U.array(),offsets=U.array()}
      for j=0,(U.get(r,'OffsetCount') or 0)-1 do
        local ok,offset=pcall(function() return r.OffsetText[j] end)
        row.offsets[#row.offsets+1]=ok and tostring(offset) or 'unavailable'
      end
      if api.vtAutoAssembler~=nil and row.variable_type==api.vtAutoAssembler then
        local source=U.get(r,'Script')
        if type(source)=='string' then row.scripts[#row.scripts+1]=addScript(source,'AA',row.key,'MemoryRecord.Script')
        else U.warn(report,'SCRIPT-UNAVAILABLE','MemoryRecord.Script unavailable',nil) end
      end
      report.records[#report.records+1]=row
      if row.active then U.warn(report,'ACTIVE-RECORD','Active record observed; bytes/signatures may already be modified by the loaded table.',nil) end
    end
  end
  if selectedOnly and not selected then U.warn(report,'SELECTION-EMPTY','Select an AA MemoryRecord first.') end
  -- Lua Engine editor contents are not table Lua; getLuaEngine can create UI.
  -- No audited passive table-Lua source is available in this capture path.
  if not selectedOnly then
    U.warn(report,'TABLE-LUA-UNAVAILABLE','Table Lua unavailable: no audited passive source; Lua Engine editor contents are not table Lua.')
  end
  report.ct.status='captured'
  report.ct.loaded_table_version=U.get(al,'LoadedTableVersion') or U.null
  for _,s in ipairs(report.scripts) do
    if s.language=='Lua' then
      for _,hint in ipairs({{'createTimer','TIMER-LIFECYCLE'}, {'debug_setBreakpoint','BREAKPOINT-OWNERSHIP'},
        {'debugger_onBreakpoint','HANDLER-CHAIN'}}) do
        if s.text:find(hint[1],1,true) then U.warn(report,hint[2],
          'Lexical Lua candidate (comments/strings may match); review resource ownership and callback teardown.',s.id) end
      end
    end
  end
end
return M

end
factories['dependencies'] = function(require, api)
-- Derived lexical inventory only. Never evaluates inspected source or resolves links.
local U=require('util')
local M={}

-- Length prefixes keep arbitrary script IDs from colliding with delimiters.
local function key(values)
  local parts={}
  for i,v in ipairs(values) do v=tostring(v);parts[i]=#v..':'..v end
  return table.concat(parts)
end

function M.summarize(occurrences)
  local groups,index=U.array(),{}
  for i,d in ipairs(occurrences or {}) do
    local identity=key({d.name,d.kind,d.source,d.relation})
    local state=index[identity]
    if not state then
      local group={name=d.name,kind=d.kind,source=d.source,relation=d.relation,
        status='unverified',occurrence_count=0,location_count=0,
        script_ids=U.array(),sections=U.array(),locations=U.array()}
      state={group=group,scripts={},sections={},locations={}}
      index[identity]=state;groups[#groups+1]=group
    end
    local g=state.group
    g.occurrence_count=g.occurrence_count+1
    if not state.scripts[d.script_id] then
      state.scripts[d.script_id]=true;g.script_ids[#g.script_ids+1]=d.script_id
    end
    if not state.sections[d.section] then
      state.sections[d.section]=true;g.sections[#g.sections+1]=d.section
    end
    local locationKey=key({d.script_id,d.section,d.line,d.command})
    local location=state.locations[locationKey]
    if not location then
      location={script_id=d.script_id,section=d.section,line=d.line,command=d.command,
        occurrence_count=0,occurrence_indices=U.array()}
      state.locations[locationKey]=location
      g.locations[#g.locations+1]=location;g.location_count=g.location_count+1
    end
    location.occurrence_count=location.occurrence_count+1
    location.occurrence_indices[#location.occurrence_indices+1]=i
  end
  return groups
end

return M

end
factories['diagnose'] = function(require, api)
-- Diagnostic model: interprets evidence that already exists in a runtime report.
-- Never scans, executes inspected code, edits tables or invents evidence.
-- A diagnostic is a conservative statement about the collected evidence only.
local U=require('util')
local M={}

-- Repair-path priority. Lower runs first. Order documented in docs/reporting.md.
-- AOB scans that could not complete rank above dependency/static review because
-- they block trust in the AOB evidence itself.
local RULE_PRIORITY={
  ['PROCESS-NOT-ATTACHED']=1,
  ['PROCESS-CHANGED']=1,
  ['MODULES-UNAVAILABLE']=2,
  ['MODULE-AMBIGUOUS']=2,
  ['AOB-NO-MATCH']=3,
  ['AOB-AMBIGUOUS']=4,
  ['AOB-SCOPE-UNRESOLVED']=5,
  ['AOB-SCAN-ERROR']=5,
  ['AOB-SCAN-UNAVAILABLE']=5,
  ['AOB-INVALIDATED']=5,
  ['AOB-UNSUPPORTED']=5,
  ['DEPENDENCY-UNRESOLVED-PROVIDER']=6,
  ['STATIC-CANDIDATE-ONLY']=7,
  ['STATIC-UNRESOLVED']=7,
  ['EVIDENCE-INSUFFICIENT']=9
}
local DEFAULT_PRIORITY=8

local SEVERITY_RANK={high=1,medium=2,low=3,info=4}

-- Review diagnostics that indicate degraded evidence, not just style advice.
local REVIEW_SEVERITY={
  ['SCAN-ERROR-VISIBILITY']='medium',
  ['MODULE-SNAPSHOT-INCOMPLETE']='medium',
  ['ACTIVE-RECORD']='medium',
  ['PROCESS-CHANGED']='high',
  ['PROCESS-UNAVAILABLE']='high',
  ['MODULES-UNAVAILABLE']='high',
  ['TABLE-LUA-UNAVAILABLE']='low',
  ['CT-UNAVAILABLE']='medium'
}

local function arr(t) return U.array(t or {}) end
local function str(v) return type(v)=='string' and v or nil end
local function num(v) return type(v)=='number' and v or nil end

local function newDiag(fields)
  return {
    id=fields.id,
    rule=fields.rule,
    category=fields.category,
    severity=fields.severity,
    status=fields.status,
    outcome=fields.outcome,
    label=fields.label or fields.rule,
    summary=fields.summary,
    evidence=arr(fields.evidence),
    confidence=fields.confidence,
    confidence_reason=arr(fields.confidence_reason),
    likely_causes=arr(fields.likely_causes),
    suggested_next_steps=arr(fields.suggested_next_steps),
    limitations=arr(fields.limitations),
    do_not_assume=arr(fields.do_not_assume),
    source=fields.source or 'runtime'
  }
end

local function aobLabel(a)
  local symbol=str(a.symbol)
  if symbol and symbol~='' then return 'AOB "'..symbol..'"' end
  local id=str(a.id)
  return id and ('AOB '..id) or 'AOB'
end

local function aobEvidence(a)
  local e={kind='runtime_aob', script_id=str(a.script_id) or U.null,
    line=num(a.line) or U.null, section=str(a.section) or U.null,
    command=str(a.command) or U.null, scope=str(a.scope) or U.null,
    pattern=str(a.pattern) or U.null, match_count=num(a.match_count) or U.null,
    uniqueness=str(a.uniqueness) or U.null, status=str(a.status) or U.null,
    description=''}
  if type(a.message)=='string' then e.message=a.message end
  if type(a.scan)=='table' then
    e.scan_start=str(a.scan.start) or U.null
    e.scan_stop=str(a.scan.stop) or U.null
    e.error_visibility=str(a.scan.error_visibility) or U.null
  end
  return e
end

local function scanScopeText(a)
  local scope=str(a.scope) or 'unknown'
  local module=str(a.arguments and a.arguments[2])
  if scope=='module' and module then return 'module '..module end
  if scope=='process' then return 'the whole readable address space' end
  return scope..' scope'
end

-- AOB diagnostics -----------------------------------------------------------
local function observedConfidence(a)
  local visibility=type(a.scan)=='table' and a.scan.error_visibility or nil
  if a.uniqueness=='unverified' or visibility=='unavailable' then
    return 'medium',{'Runtime count was read, but Cheat Engine did not expose scan error detail; uniqueness stays unverified.'}
  end
  return 'high',{'Direct runtime scan in this collection; match count reported by Cheat Engine.'}
end

local function aobDiagnostics(report, out)
  local aobs=report.aobs or {}
  local unavailable,invalidated=0,0
  for _,a in ipairs(aobs) do
    local status=str(a.status) or 'not_scanned'
    local label=aobLabel(a)
    local evidence=aobEvidence(a)
    local pattern=str(a.pattern)
    evidence.description=string.format('%s over %s%s',label,scanScopeText(a),pattern and (' with pattern "'..pattern..'"') or '')
    if status=='observed' then
      local count=num(a.match_count) or 0
      local confidence,reasons=observedConfidence(a)
      if count==0 then
        evidence.description=string.format('%s over %s returned zero matches.',label,scanScopeText(a))
        local d=newDiag({id='aob:'..tostring(a.id),rule='AOB-NO-MATCH',category='aob',
          severity='high',status='observed',outcome='problem',label=label,
          summary='AOB signature was not found in the scanned range.',
          evidence={evidence},confidence=confidence,confidence_reason=reasons,
          likely_causes={'The target executable or build differs from the one this signature was made for.',
            'The intended module is not loaded, was replaced, or has a different version.',
            'The bytes around the target instruction changed in an update.','The signature scope points at the wrong module.'},
          suggested_next_steps={'Verify the attached process and executable build are the ones this table expects.',
            'Confirm the intended module is loaded and is the expected version.',
            'Compare the signature against the current build and look for changed bytes near the original instruction.',
            'If the build changed, identify the new instruction location manually before editing anything.'},
          limitations={'Only Cheat Engine-readable memory inside the scanned range was checked.','A scan is a snapshot; the target keeps running.'},
          do_not_assume={'A missing signature does not prove the underlying feature was removed.','A missing signature does not identify the correct replacement bytes.'}})
        d.source='runtime'
        out[#out+1]=d
      elseif count==1 then
        evidence.description=string.format('%s over %s matched exactly once.',label,scanScopeText(a))
        out[#out+1]=newDiag({id='aob:'..tostring(a.id),rule='AOB-UNIQUE',category='aob',
          severity='info',status='observed',outcome='healthy',label=label,
          summary='AOB signature matched exactly once in the scanned range.',
          evidence={evidence},confidence=confidence,confidence_reason=reasons,
          limitations={'Uniqueness applies to this scan only; it does not prove other builds behave the same.'}})
      else
        evidence.description=string.format('%s over %s matched %d times.',label,scanScopeText(a),count)
        out[#out+1]=newDiag({id='aob:'..tostring(a.id),rule='AOB-AMBIGUOUS',category='aob',
          severity='medium',status='observed',outcome='problem',label=label,
          summary='AOB signature matched more than one location in the scanned range.',
          evidence={evidence},confidence=confidence,confidence_reason=reasons,
          likely_causes={'The pattern is too short to be unique in this build.','Several copies of the same code exist (templates, inlined variants, multiple modules).',
            'The scan scope is broader than intended.'},
          suggested_next_steps={'Inspect the neighbouring bytes of each reported match.','Extend the pattern with bytes that are specific to the intended instruction.',
            'Verify the intended module and instruction context before choosing a match.','Re-run Validate AOBs after narrowing the pattern.'},
          limitations={'Only the first 256 addresses are exported; later matches may differ.'},
          do_not_assume={'Multiple matches do not identify which one is the correct target.','A longer pattern is not automatically a safe pattern.'}})
      end
    elseif status=='not_scanned' then
      evidence.description=string.format('%s was inventoried from the table but never scanned.',label)
      out[#out+1]=newDiag({id='aob:'..tostring(a.id),rule='AOB-NOT-SCANNED',category='aob',
        severity='low',status='unknown',outcome='not_assessed',label=label,
        summary='Signature was detected in the table only; runtime validity has not been established.',
        evidence={evidence},confidence='unknown',confidence_reason={'No runtime scan was performed for this signature in this collection.'},
        suggested_next_steps={'Run Validate AOBs with the intended process attached.','Confirm the table is the one loaded in the target session.'},
        do_not_assume={'Detected in source only. Runtime validity has not been established.'},source='runtime'})
    elseif status=='unsupported' then
      evidence.description=string.format('%s is outside supported scan syntax.',label)
      out[#out+1]=newDiag({id='aob:'..tostring(a.id),rule='AOB-UNSUPPORTED',category='aob',
        severity='low',status='unsupported',outcome='not_assessed',label=label,
        summary='Signature or scope is outside the scan syntax CESuite supports, so no runtime evidence exists.',
        evidence={evidence},confidence='unknown',confidence_reason={'The pattern or argument count could not be scanned as written.'},
        suggested_next_steps={'Use a literal byte/nibble wildcard pattern with the expected argument count.','Review the pattern manually; CESuite will not widen the scan.'},
        limitations={'CESuite does not translate or repair patterns.'},source='runtime'})
    elseif status=='unresolved' then
      evidence.description=string.format('%s could not be resolved to a scan range.',label)
      out[#out+1]=newDiag({id='aob:'..tostring(a.id),rule='AOB-SCOPE-UNRESOLVED',category='aob',
        severity='medium',status='unknown',outcome='problem',label=label,
        summary='The scan scope could not be resolved, so the signature was not validated.',
        evidence={evidence},confidence='medium',confidence_reason={'The scope expression could not be resolved from enumerated modules or constants.'},
        likely_causes={'The module name in the scan does not match any enumerated module.','The module size is unavailable, for example with duplicate module names.',
          'The scope uses an expression CESuite does not evaluate.'},
        suggested_next_steps={'Verify the module name used by the scan is loaded in this process.','Check whether duplicate module names make the scope ambiguous.',
          'Test the scope manually in Cheat Engine before changing the table.'},
        limitations={'CESuite deliberately does not evaluate arbitrary expressions or symbol tables.'},
        do_not_assume={'An unresolved scope is not evidence that the signature is wrong.'},source='runtime'})
    elseif status=='error' then
      evidence.description=string.format('The scan for %s failed inside Cheat Engine.',label)
      out[#out+1]=newDiag({id='aob:'..tostring(a.id),rule='AOB-SCAN-ERROR',category='aob',
        severity='medium',status='unknown',outcome='problem',label=label,
        summary='Cheat Engine reported an error while scanning this signature.',
        evidence={evidence},confidence='medium',confidence_reason={'The scan raised an error; no match count is available.'},
        suggested_next_steps={'Review Cheat Engine scan settings and memory types.','Retry Validate AOBs with the process attached and idle.',
          'If the error persists, simplify the pattern to isolate the failing input.'},
        limitations={'The error text comes from Cheat Engine, not from the table.'},source='runtime'})
    elseif status=='unavailable' then
      unavailable=unavailable+1
    elseif status=='invalidated' then
      invalidated=invalidated+1
    end
  end
  if unavailable&gt;0 then
    out[#out+1]=newDiag({id='aob:unavailable',rule='AOB-SCAN-UNAVAILABLE',category='aob',
      severity=report.target and report.target.attached==true and 'medium' or 'high',
      status='unknown',outcome='problem',label=tostring(unavailable)..' AOB scan(s)',
      summary='Some AOB scans could not run because no process was attached or the target changed.',
      evidence={{kind='aggregate',description=tostring(unavailable)..' AOB scan(s) were marked unavailable.',count=unavailable}},
      confidence='high',confidence_reason={'The collection recorded that no valid attached process was available for these scans.'},
      suggested_next_steps={'Attach Cheat Engine to the intended process.','Re-run Validate AOBs without switching process.','Keep the target attached while the analysis runs.'},
      do_not_assume={'Missing scans say nothing about the signature itself.'},source='runtime'})
  end
  if invalidated&gt;0 then
    out[#out+1]=newDiag({id='aob:invalidated',rule='AOB-INVALIDATED',category='aob',
      severity='high',status='unknown',outcome='problem',label=tostring(invalidated)..' AOB scan(s)',
      summary='The attached process changed during scanning, so those results were discarded.',
      evidence={{kind='aggregate',description=tostring(invalidated)..' AOB result(s) were invalidated.',count=invalidated}},
      confidence='high',confidence_reason={'The process or module identity changed during collection.'},
      suggested_next_steps={'Re-run the analysis without changing the attached process.','Close other tools that attach to the same target.'},
      do_not_assume={'Invalidated results are not evidence about the table.'},source='runtime'})
  end
end

-- Target / module diagnostics ----------------------------------------------
local function targetDiagnostics(report, out)
  local target=report.target or {}
  if target.attached~=true then
    out[#out+1]=newDiag({id='target:not-attached',rule='PROCESS-NOT-ATTACHED',category='target',
      severity='high',status='observed',outcome='problem',label='Target process',
      summary='No process was attached, so runtime evidence is unavailable.',
      evidence={{kind='target',description='target.attached = false; no runtime memory was read.',pid=U.null,name=U.null}},
      confidence='high',confidence_reason={'The collection recorded no attached process.'},
      likely_causes={'Cheat Engine was not attached to a process.','The process was closed before the analysis started.'},
      suggested_next_steps={'Attach Cheat Engine to the intended process.','Load the table you want to review, then run Analyze Loaded Table or Validate AOBs.'},
      limitations={'Without an attached process, CESuite cannot validate any runtime signature.'},
      do_not_assume={'A table analysed without a process is not evidence that the table is broken.'},source='runtime'})
  end
  local changed=false
  for _,w in ipairs(report.diagnostics or {}) do
    if str(w.rule)=='PROCESS-CHANGED' then changed=true end
  end
  for _,a in ipairs(report.aobs or {}) do
    if str(a.status)=='invalidated' then changed=true end
  end
  if changed then
    out[#out+1]=newDiag({id='target:process-changed',rule='PROCESS-CHANGED',category='target',
      severity='high',status='observed',outcome='problem',label='Target process',
      summary='The attached process changed during collection, so results are not reliable.',
      evidence={{kind='target',description='PROCESS-CHANGED was recorded, or an AOB result was invalidated.'}},
      confidence='high',confidence_reason={'CESuite detected a process or module identity change.'},
      suggested_next_steps={'Re-run the analysis without switching process.','Avoid attaching or restructuring modules while the analysis runs.'},
      do_not_assume={'Results from a changed process are not evidence about the table.'},source='runtime'})
  end
end

local function moduleDiagnostics(report, out)
  local unavailable=false
  local ambiguous={}
  for _,w in ipairs(report.diagnostics or {}) do
    local rule=str(w.rule)
    if rule=='MODULES-UNAVAILABLE' then unavailable=true end
    if rule=='MODULE-SNAPSHOT-INCOMPLETE' then
      local message=str(w.message) or 'duplicate module name'
      ambiguous[#ambiguous+1]=message
    end
  end
  if unavailable then
    out[#out+1]=newDiag({id='module:unavailable',rule='MODULES-UNAVAILABLE',category='module',
      severity='high',status='unknown',outcome='problem',label='Module list',
      summary='The loaded module list could not be enumerated.',
      evidence={{kind='modules',description='enumModules failed or returned an unusable table.'}},
      confidence='high',confidence_reason={'No module inventory was produced.'},
      suggested_next_steps={'Confirm the process is attached and still running.','Check that Cheat Engine can list modules for this target.','Re-run the analysis.'},
      limitations={'Scoped AOB scans cannot be validated without a module list.'},
      do_not_assume={'A missing module list is not evidence about the table.'},source='runtime'})
  end
  if #ambiguous&gt;0 then
    local evidence={}
    for i=1,math.min(#ambiguous,5) do
      evidence[#evidence+1]={kind='module_ambiguity',description=ambiguous[i]}
    end
    out[#out+1]=newDiag({id='module:ambiguous',rule='MODULE-AMBIGUOUS',category='module',
      severity='medium',status='observed',outcome='problem',label='Module snapshot',
      summary='Ambiguous module names were found; sizes and scoped scans were withheld.',
      evidence=evidence,confidence='high',confidence_reason={'Duplicate normalized module names were enumerated.'},
      likely_causes={'Two loaded modules share the same file name.','A module appears twice in the enumeration.'},
      suggested_next_steps={'Identify which module the table intends by full path.','Avoid name-only scoped scans while duplicates exist.','Re-run after resolving the duplicate.'},
      limitations={'CESuite does not choose a first match on your behalf.'},
      do_not_assume={'A null module size does not mean the module is absent.'},source='runtime'})
  end
end

-- Dependency diagnostics ---------------------------------------------------
-- Names the static analyser classifies as AOB sinks. The dependency inventory
-- records every bare identifier; these are Cheat Engine scan calls, so treating
-- them as unresolved table symbols would contradict the AOB classification.
local SINK_NAMES={aobscan=true,aobscanmodule=true,aobscanregion=true,
  aobscanunique=true,aobscanmoduleunique=true,customscan=true}

local function dependencyDiagnostics(report, out)
  local providers={}
  for _,d in ipairs(report.dependencies or {}) do
    if str(d.relation)=='provides' and str(d.name) then providers[str(d.name):lower()]=true end
  end
  local unresolved={}
  for _,d in ipairs(report.dependencies or {}) do
    local name=str(d.name)
    if str(d.relation)=='requires' and name and not providers[name:lower()]
      and not SINK_NAMES[name:lower()] then
      local entry=unresolved[name]
      if not entry then
        entry={count=0,first=d}
        unresolved[name]=entry
      end
      entry.count=entry.count+1
    end
  end
  local names={}
  for name in pairs(unresolved) do names[#names+1]=name end
  table.sort(names)
  -- Bound the number of dependency diagnostics: large tables can produce many
  -- lexical requires with no visible provider. Remaining names stay in the
  -- extensive report through the raw dependency inventory.
  for i=1,math.min(#names,200) do
    local name=names[i]
    local entry=unresolved[name]
    local d=entry.first
    out[#out+1]=newDiag({id='dependency:'..name,rule='DEPENDENCY-UNRESOLVED-PROVIDER',category='dependency',
      severity='low',status='candidate',outcome='advisory',label='Symbol "'..name..'"',
      summary='A required symbol has no provider occurrence in the analysed scripts.',
      evidence={{kind='lexical_requires',description=string.format('Required %d time(s); no provides occurrence was inventoried.',entry.count),
        name=name,count=entry.count,script_id=str(d.script_id) or U.null,line=num(d.line) or U.null,
        section=str(d.section) or U.null,command=str(d.command) or U.null,kind_detail=str(d.kind) or U.null}},
      confidence='low',confidence_reason={'This is a lexical requires occurrence; no runtime resolution was attempted.'},
      likely_causes={'The provider script is not loaded or did not run in this table version.','The symbol was renamed or removed.',
        'The provider comes from table Lua, a CE built-in, or generated code that passive capture cannot see.'},
      suggested_next_steps={'Confirm the provider script is present and enabled.','Check activation order: providers must run before consumers.',
        'Check whether the symbol was renamed.','Review registersymbol/define relationships in the table.'},
      limitations={'Only script text present in this collection was inspected.'},
      do_not_assume={'A missing provider in source does not prove the symbol is undefined at runtime.'},source='lexical'})
  end
end

-- Static Lua diagnostics ---------------------------------------------------
local function normalizeKey(pattern)
  if type(pattern)~='string' then return nil end
  local compact=pattern:gsub('%s+','')
  if compact=='' then return nil end
  return compact:upper()
end

local function staticDiagnostics(report, out)
  local static=report.static_lua_analysis
  if type(static)~='table' then return end
  local groups,unknown={},0
  local runtimeByPattern={}
  for _,a in ipairs(report.aobs or {}) do
    if str(a.status)=='observed' then
      local key=normalizeKey(str(a.pattern))
      if key then runtimeByPattern[key]=a end
    end
  end
  for _,o in ipairs(static.observations or {}) do
    if str(o.status)=='source-candidate' and str(o.pattern) then
      local key=normalizeKey(o.pattern) or o.pattern
      local group=groups[key]
      if not group then
        group={pattern=o.pattern,count=0,occurrences={}}
        groups[key]=group
      end
      group.count=group.count+1
      if #group.occurrences&lt;5 then group.occurrences[#group.occurrences+1]=o end
    else
      unknown=unknown+1
    end
  end
  local keys={}
  for k in pairs(groups) do keys[#keys+1]=k end
  table.sort(keys)
  for i=1,math.min(#keys,200) do
    local group=groups[keys[i]]
    local evidence={}
    for _,o in ipairs(group.occurrences) do
      evidence[#evidence+1]={kind='static_observation',description=string.format('Line %s in script %s via %s.',
        tostring(o.line),tostring(o.script_id),tostring(o.sink)),
        script_id=str(o.script_id) or U.null,line=num(o.line) or U.null,sink=str(o.sink) or U.null,
        symbol=str(o.symbol) or U.null,pattern=str(o.pattern) or U.null}
    end
    local corroborated=runtimeByPattern[keys[i]]
    local confidence='low'
    local reasons={'Static lexical inventory only; no memory scan was run for this candidate.'}
    if corroborated then
      evidence[#evidence+1]={kind='runtime_corroboration',
        description='The same normalized pattern was also observed in a runtime scan in this collection.',
        match_count=num(corroborated.match_count) or U.null,
        status=str(corroborated.status) or U.null,
        script_id=str(corroborated.script_id) or U.null,line=num(corroborated.line) or U.null}
      reasons[#reasons+1]='A runtime scan with this normalized pattern exists, but it is separate evidence.'
      confidence='medium'
    end
    out[#out+1]=newDiag({id='static:'..tostring(group.pattern),rule='STATIC-CANDIDATE-ONLY',category='static',
      severity='info',status='candidate',outcome='advisory',label='Static candidate "'..tostring(group.pattern)..'"',
      summary='A signature candidate was detected in Lua source only; runtime validity has not been established.',
      evidence=evidence,confidence=confidence,confidence_reason=reasons,
      suggested_next_steps={'Run Validate AOBs or a manual scan for this pattern with the target attached.',
        'Confirm the Lua path that registers this pattern actually runs in the target session.'},
      limitations={'Static analysis never executes Lua and cannot see computed patterns.'},
      do_not_assume={'A source literal does not prove the scan runs or succeeds.','Static candidates are never treated as runtime observations.'},source='static'})
  end
  if unknown&gt;0 then
    out[#out+1]=newDiag({id='static:unresolved',rule='STATIC-UNRESOLVED',category='static',
      severity='info',status='unknown',outcome='not_assessed',label='Static Lua candidates',
      summary='Some Lua source candidates could not be resolved to a literal pattern.',
      evidence={{kind='aggregate',description=tostring(unknown)..' static observation(s) had no resolvable pattern.',count=unknown}},
      confidence='unknown',confidence_reason={'The source expressions were dynamic, incomplete or outside supported syntax.'},
      suggested_next_steps={'Review the referenced Lua manually.','Run the table in the target and validate the pattern by scanning.'},
      limitations={'CESuite does not evaluate Lua expressions.'},source='static'})
  end
  local limit=0
  for _,d in ipairs(static.diagnostics or {}) do
    if str(d.rule)=='LUA-STATIC-LIMIT' then limit=limit+1 end
  end
  if limit&gt;0 then
    out[#out+1]=newDiag({id='static:limit',rule='STATIC-ANALYSIS-LIMIT',category='static',
      severity='low',status='unknown',outcome='not_assessed',label='Static Lua analysis',
      summary='Some Lua sources exceeded static analysis limits or could not be tokenized.',
      evidence={{kind='aggregate',description=tostring(limit)..' static Lua source(s) hit a limit or failed to tokenize.',count=limit}},
      confidence='high',confidence_reason={'The analyser reported a deterministic limit or tokenizer error.'},
      suggested_next_steps={'Review the affected Lua sources manually.','Reduce dynamic or generated content before static analysis.'},
      limitations={'Unanalysed source is not evidence of absence.'},source='static'})
  end
end

-- Review diagnostics -------------------------------------------------------
local consumed={
  ['PROCESS-CHANGED']=true,['PROCESS-UNAVAILABLE']=true,['MODULES-UNAVAILABLE']=true,
  ['MODULE-SNAPSHOT-INCOMPLETE']=true
}

local REVIEW_SUMMARY={
  ['HOOK-REVIEW']='Hook placement needs manual review: anchor, jump span, overwrite and restore are unverified.',
  ['LUA-RVA-HOOK']='A Lua module+RVA hook candidate was detected lexically; runtime behaviour is unverified.',
  ['RESOURCE-OWNERSHIP']='Resource cleanup spans more than one owner; ownership is unverified.',
  ['RESTORE-BEFORE-FREE']='A resource is freed; full byte restoration before free is unverified.',
  ['EMPTY-DISABLE']='A DISABLE section appears empty; persistence may be intentional.',
  ['DYNAMIC-SOURCE']='The script contains dynamic source; literal observations may not match what runs.',
  ['AMBIGUOUS-ANCHOR']='An AOB symbol is reused in one script; hook candidates were omitted.',
  ['SCAN-ERROR-VISIBILITY']='Cheat Engine did not expose scan error detail; uniqueness stays unverified.',
  ['ACTIVE-RECORD']='An active record was observed; target bytes may already be modified.',
  ['TABLE-LUA-UNAVAILABLE']='Standalone table Lua cannot be captured passively; some dependencies may be missing.',
  ['CT-UNAVAILABLE']='The address list could not be read.',
  ['AA-TYPE-UNAVAILABLE']='The Auto Assembler type constant is unavailable; AA scripts cannot be classified.',
  ['CT-LIMIT']='The record inventory was truncated at the record limit.',
  ['RECORD-UNAVAILABLE']='A record could not be read.',
  ['SCRIPT-UNAVAILABLE']='A script source was unavailable.',
  ['SELECTION-EMPTY']='No record was selected for Inspect Selected Script.'
}

local function reviewDiagnostics(report, out)
  local counts,order={},{}
  for _,w in ipairs(report.diagnostics or {}) do
    local rule=str(w.rule)
    if rule and not consumed[rule] then
      local state=counts[rule]
      if not state then
        state={count=0,examples={}}
        counts[rule]=state;order[#order+1]=rule
      end
      state.count=state.count+1
      if #state.examples&lt;5 then state.examples[#state.examples+1]=w end
    end
  end
  table.sort(order)
  for _,rule in ipairs(order) do
    local state=counts[rule]
    local evidence={}
    for _,w in ipairs(state.examples) do
      evidence[#evidence+1]={kind='report_diagnostic',description=str(w.message) or rule,
        rule=rule,script_id=str(w.script_id) or U.null,line=num(w.line) or U.null}
    end
    out[#out+1]=newDiag({id='review:'..rule,rule=rule,category='review',
      severity=REVIEW_SEVERITY[rule] or 'low',status='candidate',outcome='advisory',
      label=rule..' ('..tostring(state.count)..')',
      summary=REVIEW_SUMMARY[rule] or ('Review diagnostic '..rule..' was reported.'),
      evidence=evidence,confidence='low',confidence_reason={'This is a lexical review diagnostic, not a runtime proof.'},
      suggested_next_steps={'Open the referenced script and line.','Verify the behaviour manually in Cheat Engine before changing anything.'},
      limitations={'Review diagnostics are advisory and may be false positives in comments or strings.'},source='lexical'})
  end
end

-- Assessment ---------------------------------------------------------------
local function scopeSummary(report)
  local target=report.target or {}
  local modules=report.modules or {}
  local scripts=report.scripts or {}
  local aobs=report.aobs or {}
  local deps=report.dependencies or {}
  local static=report.static_lua_analysis
  local candidates=0
  if type(static)=='table' then
    for _,o in ipairs(static.observations or {}) do
      if str(o.status)=='source-candidate' then candidates=candidates+1 end
    end
  end
  local name=U.null
  if type(target.name)=='string' and target.name~='' then name=target.name end
  local pid=U.null
  if type(target.pid)=='number' then pid=target.pid end
  return {
    attached=target.attached==true,
    pid=pid,
    process_name=name,
    module_count=#modules,
    script_count=#scripts,
    aob_count=#aobs,
    dependency_occurrence_count=#deps,
    static_candidate_count=candidates
  }
end

local function sortDiagnostics(diagnostics)
  local function key(d)
    return string.format('%d|%d|%s|%s',RULE_PRIORITY[d.rule] or DEFAULT_PRIORITY,
      SEVERITY_RANK[d.severity] or 9,d.id,d.rule)
  end
  table.sort(diagnostics,function(a,b) return key(a)&lt;key(b) end)
  return diagnostics
end

local function plural(n,singular,pluralForm)
  if n==1 then return tostring(n)..' '..singular end
  return tostring(n)..' '..(pluralForm or (singular..'s'))
end

local function actionFor(d)
  local rule=d.rule
  if rule=='PROCESS-NOT-ATTACHED' then return 'Attach Cheat Engine to the intended process, then re-run the analysis.' end
  if rule=='PROCESS-CHANGED' then return 'Re-run the analysis without changing the attached process.' end
  if rule=='MODULES-UNAVAILABLE' then return 'Confirm module enumeration works for the attached process.' end
  if rule=='MODULE-AMBIGUOUS' then return 'Resolve duplicate module names before trusting scoped scans.' end
  if rule=='AOB-NO-MATCH' then return 'Review '..d.label..' — the runtime scan returned zero matches.' end
  if rule=='AOB-AMBIGUOUS' then return 'Review '..d.label..' — the runtime scan returned multiple matches.' end
  if rule=='AOB-SCOPE-UNRESOLVED' then return 'Resolve the scan scope for '..d.label..'.' end
  if rule=='AOB-SCAN-ERROR' then return 'Retry the scan for '..d.label..' after checking Cheat Engine scan settings.' end
  if rule=='AOB-SCAN-UNAVAILABLE' then return 'Attach the intended process and re-run the AOB scans.' end
  if rule=='AOB-INVALIDATED' then return 'Re-run the analysis; the process changed while scanning.' end
  if rule=='AOB-UNSUPPORTED' then return 'Review '..d.label..' manually; it is outside supported scan syntax.' end
  if rule=='DEPENDENCY-UNRESOLVED-PROVIDER' then
    local name=(d.evidence[1] and type(d.evidence[1].name)=='string') and d.evidence[1].name or d.label
    return 'Check the provider for symbol "'..name..'".'
  end
  if rule=='STATIC-CANDIDATE-ONLY' then
    local pattern=(d.evidence[1] and type(d.evidence[1].pattern)=='string') and d.evidence[1].pattern or d.label
    return 'Validate static candidate "'..pattern..'" against the running target.'
  end
  if rule=='STATIC-UNRESOLVED' then return 'Review the unresolved Lua sources manually.' end
  if rule=='STATIC-ANALYSIS-LIMIT' then return 'Review the Lua sources that exceeded static analysis limits.' end
  if rule=='EVIDENCE-INSUFFICIENT' then return 'Collect evidence first: attach a process, load the table and run the analysis.' end
  if d.category=='review' then return 'Review the '..tostring(d.rule)..' findings and the referenced lines.' end
  return 'Review '..tostring(d.label)..'.'
end

local function rationaleFor(d)
  return string.format('%s (%s; confidence %s).',d.summary,d.status,d.confidence)
end

function M.build(report)
  assert(type(report)=='table','diagnose.build requires a report table')
  local diagnostics={}
  targetDiagnostics(report,diagnostics)
  moduleDiagnostics(report,diagnostics)
  aobDiagnostics(report,diagnostics)
  dependencyDiagnostics(report,diagnostics)
  staticDiagnostics(report,diagnostics)
  reviewDiagnostics(report,diagnostics)

  local hasAobs=#(report.aobs or {})&gt;0
  local hasScripts=#(report.scripts or {})&gt;0
  local hasDeps=#(report.dependencies or {})&gt;0
  local static=report.static_lua_analysis
  local hasStatic=type(static)=='table' and #(static.observations or {})&gt;0
  if not hasAobs and not hasScripts and not hasDeps and not hasStatic then
    diagnostics[#diagnostics+1]=newDiag({id='evidence:none',rule='EVIDENCE-INSUFFICIENT',category='evidence',
      severity='medium',status='unknown',outcome='not_assessed',label='Evidence',
      summary='Not enough evidence to recommend a repair step.',
      evidence={{kind='aggregate',description='No scripts, AOB records, dependencies or static candidates were collected.'}},
      confidence='unknown',confidence_reason={'The collection was empty.'},
      suggested_next_steps={'Attach Cheat Engine to the intended process.','Load the table you want to review.',
        'Run Analyze Loaded Table and Validate AOBs, then run Diagnostics again.'},
      do_not_assume={'An empty collection is not evidence that the table is healthy.'},source='runtime'})
  end

  sortDiagnostics(diagnostics)

  local counts={total=#diagnostics,problems=0,healthy=0,advisory=0,not_assessed=0}
  local byId={}
  for _,d in ipairs(diagnostics) do
    byId[d.id]=d
    if d.outcome=='problem' then counts.problems=counts.problems+1
    elseif d.outcome=='healthy' then counts.healthy=counts.healthy+1
    elseif d.outcome=='advisory' then counts.advisory=counts.advisory+1
    else counts.not_assessed=counts.not_assessed+1 end
  end

  local repair_path,order=U.array(),0
  for _,d in ipairs(diagnostics) do
    if d.outcome=='problem' or d.outcome=='advisory' then
      order=order+1
      repair_path[#repair_path+1]={order=order,action=actionFor(d),diagnostic_id=d.id,
        rationale=rationaleFor(d)}
    end
  end

  local headline
  if counts.problems&gt;0 then
    headline=string.format('%s found; %s passed, %s, %s.',
      plural(counts.problems,'problem'),plural(counts.healthy,'check'),
      plural(counts.advisory,'advisory finding'),plural(counts.not_assessed,'item not assessed','items not assessed'))
  elseif counts.advisory&gt;0 then
    headline='No runtime problems found; '..plural(counts.advisory,'advisory finding')..' for manual review.'
  elseif counts.healthy&gt;0 then
    headline='No problems found in the evidence collected; '..plural(counts.healthy,'check')..' passed.'
  else
    headline='Not enough evidence to recommend a repair step.'
  end

  local statements=U.array({
    'Diagnostics are derived from the evidence in this report only; no table was modified.',
    'Static Lua candidates are source observations and are never treated as runtime matches.'
  })
  if #repair_path&gt;0 then statements[#statements+1]='Suggested next steps follow a fixed, documented priority order.' end

  return {
    schema_version='0.1',
    generated_at=report.generated_at or U.null,
    completed_at=report.completed_at or U.null,
    mode=report.mode or 'unknown',
    scope=scopeSummary(report),
    counts=counts,
    headline=headline,
    statements=statements,
    diagnostics=U.array(diagnostics),
    repair_path=repair_path,
    limitations=U.array({
      'Diagnostics interpret collected evidence; they do not prove runtime behaviour beyond the recorded scans.',
      'No table, script, module or target memory was modified.',
      'Static candidates are source-only and are never promoted to runtime observations.',
      'Re-run the analysis after changing the table, the target or the attached process.'
    })
  }
end

M.RULE_PRIORITY=RULE_PRIORITY
M.REVIEW_SEVERITY=REVIEW_SEVERITY
return M

end
factories['disassembly'] = function(require, api)
local U=require('util')
local M={}
-- CE does not document a universal RIP-relative flag. Recognize only selected
-- legacy one-byte opcodes whose ModRM position is known; all others stay unknown.
function M.rip(bytes,arch)
  if arch=='x86' then return 'not_applicable' end
  if arch~='x64' then return 'unknown' end
  local i,addressOverride=1,false
  while bytes[i] do
    local b=bytes[i]
    if b==0x67 then addressOverride=true;i=i+1
    elseif b==0x66 or b==0xF0 or b==0xF2 or b==0xF3 or b==0x2E or b==0x36 or b==0x3E or b==0x26 or b==0x64 or b==0x65 or (b&gt;=0x40 and b&lt;=0x4F) then i=i+1
    else break end
  end
  local op=bytes[i]
  local known={[0x8B]=true,[0x89]=true,[0x8D]=true,[0x8A]=true,[0x88]=true,[0xFF]=true,[0xC7]=true,[0xC6]=true,
    [0x01]=true,[0x03]=true,[0x29]=true,[0x2B]=true,[0x39]=true,[0x3B]=true,[0x85]=true}
  local modrm=bytes[i+1]
  if not known[op] or not modrm then return 'unknown' end
  if addressOverride then return 'not_rip_relative' end
  return modrm&lt;0x40 and modrm%8==5 and 'rip_relative' or 'not_rip_relative'
end
-- Compatibility stub: CE disassembly can invoke global overrides/callbacks.
-- Omit optional context without accessing CE APIs.
function M.capture(api,address,arch)
  return nil
end

-- Conservative decoder from raw bytes. It never calls Cheat Engine disassembly,
-- never executes target code and never guesses an unsupported opcode.
-- Operand size is tracked in BITS; helpers derive bytes where needed, so an
-- 8-bit operand can never be mistaken for an 8-byte register.
local REG64={'rax','rcx','rdx','rbx','rsp','rbp','rsi','rdi',
  'r8','r9','r10','r11','r12','r13','r14','r15'}
local REG32={'eax','ecx','edx','ebx','esp','ebp','esi','edi',
  'r8d','r9d','r10d','r11d','r12d','r13d','r14d','r15d'}
local REG16={'ax','cx','dx','bx','sp','bp','si','di',
  'r8w','r9w','r10w','r11w','r12w','r13w','r14w','r15w'}
-- Without REX, ModRM indexes 4-7 address ah/ch/dh/bh; any REX prefix (even one
-- without bits) redirects them to spl/bpl/sil/dil.
local REG8={'al','cl','dl','bl','ah','ch','dh','bh',
  'r8b','r9b','r10b','r11b','r12b','r13b','r14b','r15b'}
local REG8_REX={'al','cl','dl','bl','spl','bpl','sil','dil',
  'r8b','r9b','r10b','r11b','r12b','r13b','r14b','r15b'}
local XMM={'xmm0','xmm1','xmm2','xmm3','xmm4','xmm5','xmm6','xmm7',
  'xmm8','xmm9','xmm10','xmm11','xmm12','xmm13','xmm14','xmm15'}

local SSE_SINGLE={[0x10]='movss',[0x11]='movss',[0x2E]='ucomiss',[0x2F]='comiss',
  [0x58]='addss',[0x59]='mulss',[0x5C]='subss',[0x5E]='divss'}
local SSE_DOUBLE={[0x10]='movsd',[0x11]='movsd',[0x2E]='ucomisd',[0x2F]='comisd',
  [0x58]='addsd',[0x59]='mulsd',[0x5C]='subsd',[0x5E]='divsd'}

local OP1={
  [0x01]={name='add',form='rm,reg'},
  [0x03]={name='add',form='reg,rm'},
  [0x09]={name='or',form='rm,reg'},
  [0x0B]={name='or',form='reg,rm'},
  [0x21]={name='and',form='rm,reg'},
  [0x23]={name='and',form='reg,rm'},
  [0x29]={name='sub',form='rm,reg'},
  [0x2B]={name='sub',form='reg,rm'},
  [0x31]={name='xor',form='rm,reg'},
  [0x33]={name='xor',form='reg,rm'},
  [0x39]={name='cmp',form='rm,reg'},
  [0x3B]={name='cmp',form='reg,rm'},
  [0x85]={name='test',form='rm,reg'},
  [0x88]={name='mov',form='rm,reg',bits=8},
  [0x89]={name='mov',form='rm,reg'},
  [0x8A]={name='mov',form='reg,rm',bits=8},
  [0x8B]={name='mov',form='reg,rm'},
  [0x8D]={name='lea',form='reg,mem'},
  [0xC6]={name='mov',form='rm,imm',bits=8,imm=1},
  [0xC7]={name='mov',form='rm,imm',imm=4},
  [0x63]={name='movsxd',form='reg,rm',x64only=true}
}
local X87={[0xD9]=32,[0xDD]=64}
local X87_GROUP={[0]='fld',[2]='fst',[3]='fstp'}

local function is64(arch) return arch=='x86_64' or arch=='x64' end
local function is32(arch) return arch=='i386' or arch=='x86' end

local function bytesAt(bytes,i,n)
  for k=0,n-1 do if bytes[i+k]==nil then return false end end
  return true
end

local function readSigned(bytes,i,size)
  if not bytesAt(bytes,i,size) then return nil end
  if size==1 then
    local v=bytes[i]
    if v&gt;=0x80 then v=v-256 end
    return v
  end
  local v=0
  for k=size-1,0,-1 do v=v*256+bytes[i+k] end
  if v&gt;=0x80000000 then v=v-0x100000000 end
  return v
end

local function readUnsigned(bytes,i,size)
  if not bytesAt(bytes,i,size) then return nil end
  local v=0
  for k=size-1,0,-1 do v=v*256+bytes[i+k] end
  return v
end

-- 8-bit register naming depends on the mere presence of any REX prefix.
local function gpr8(index,has_rex)
  if index&lt;4 then return REG8[index+1] end
  if index&lt;8 then return has_rex and REG8_REX[index+1] or REG8[index+1] end
  return REG8[index+1] or 'r8b'
end

local function gpr(index,bits,is64bit,addr32,has_rex)
  if bits==8 then return gpr8(index,has_rex) end
  if not is64bit or addr32 then
    if bits==16 then return REG16[index+1] or REG16[1] end
    return REG32[index+1] or REG32[1]
  end
  if bits==16 then return REG16[index+1] or REG16[1] end
  if bits==64 then return REG64[index+1] or REG64[1] end
  return REG32[index+1] or REG32[1]
end

-- Address registers are pointer sized (32-bit with 0x67 in 64-bit mode).
local function addrReg(index,is64bit,addr32)
  if is64bit and not addr32 then return REG64[index+1] or REG64[1] end
  return REG32[index+1] or REG32[1]
end

local function sizePrefix(bits)
  if bits==8 then return 'byte ptr ' end
  if bits==16 then return 'word ptr ' end
  if bits==32 then return 'dword ptr ' end
  if bits==64 then return 'qword ptr ' end
  return ''
end

local function memText(mem)
  if mem.absolute then return string.format('[0x%X]',mem.displacement) end
  local parts={}
  if mem.rip_relative then parts[#parts+1]='rip'
  elseif mem.base_register then parts[#parts+1]=mem.base_register end
  if mem.index_register then
    parts[#parts+1]=mem.scale and mem.scale~=1
      and (mem.index_register..'*'..tostring(mem.scale)) or mem.index_register
  end
  local disp=mem.displacement or 0
  if #parts==0 then return string.format('[0x%X]',disp) end
  local text='['..table.concat(parts,'+')
  if disp&lt;0 then text=text..string.format('-0x%X',-disp)
  elseif disp&gt;0 then text=text..string.format('+0x%X',disp) end
  return text..']'
end

local function emptyMemory()
  return {present=false,base_register=nil,index_register=nil,scale=nil,displacement=nil,
    rip_relative=false,absolute=false,expression_text=nil,is_stack_reference=false}
end

-- SSE mnemonic and operand size in bits. 0F 10/11/28/29 differentiate on
-- 66 (packed double), F3 (scalar single) and F2 (scalar double).
local function sseMnemonic(pfx,op2)
  if op2==0x10 or op2==0x11 then
    if pfx[0xF3] then return 'movss',32 end
    if pfx[0xF2] then return 'movsd',64 end
    if pfx[0x66] then return 'movupd',128 end
    return 'movups',128
  end
  if op2==0x28 or op2==0x29 then
    if pfx[0xF3] or pfx[0xF2] then return nil end
    if pfx[0x66] then return 'movapd',128 end
    return 'movaps',128
  end
  if op2==0x58 or op2==0x59 or op2==0x5C or op2==0x5E then
    if pfx[0xF3] then return SSE_SINGLE[op2],32 end
    if pfx[0xF2] then return SSE_DOUBLE[op2],64 end
    return nil
  end
  if op2==0x2E or op2==0x2F then
    if pfx[0xF2] or pfx[0x66] then return SSE_DOUBLE[op2],64 end
    return SSE_SINGLE[op2],32
  end
  return nil
end

-- Reported status values: decoded | unsupported | truncated | invalid.
function M.decode(bytes,arch)
  local is64bit,is32bit=is64(arch),is32(arch)
  if not (is64bit or is32bit) then
    return {status='unsupported',reason='unsupported_architecture'}
  end
  if type(bytes)~='table' or #bytes==0 then
    return {status='invalid',reason='no_bytes'}
  end
  local i,prefixes,pfx=1,{}, {}
  while true do
    local b=bytes[i]
    if b==nil then return {status='truncated',reason='prefix_only'} end
    if b==0x66 or b==0x67 or b==0xF0 or b==0xF2 or b==0xF3 or b==0x2E or b==0x36
      or b==0x3E or b==0x26 or b==0x64 or b==0x65 then
      prefixes[#prefixes+1]=b;pfx[b]=true;i=i+1
    elseif is64bit and b&gt;=0x40 and b&lt;=0x4F then
      prefixes[#prefixes+1]=b;pfx.rex=b;i=i+1
    else break end
  end
  local op=bytes[i]
  if op==nil then return {status='truncated',reason='missing_opcode'} end
  if is32bit and pfx[0x67] then
    return {status='unsupported',reason='unsupported_address_size'}
  end
  local rex=pfx.rex
  local rex_w=rex and (rex &amp; 0x8)~=0
  local rex_r=rex and (rex &amp; 0x4)~=0
  local rex_x=rex and (rex &amp; 0x2)~=0
  local rex_b=rex and (rex &amp; 0x1)~=0
  local has_rex=rex~=nil
  local addr32=pfx[0x67]==true
  local result={status='decoded',reason=nil,length=nil,prefixes=prefixes,opcode=op,
    opcode_text=nil,modrm=nil,sib=nil,displacement=nil,operand_size=nil,
    mnemonic=nil,operands_text=nil,rip_relative=false,memory=emptyMemory()}
  local prefix_text={}
  for _,b in ipairs(prefixes) do prefix_text[#prefix_text+1]=string.format('%02X',b) end
  prefix_text=table.concat(prefix_text,' ')

  local mnemonic,form,imm_size,bits,sse_store
  if op==0x0F then
    local op2=bytes[i+1]
    if op2==nil then result.status='truncated';result.reason='missing_second_opcode';return result end
    result.opcode_text=(prefix_text~='' and (prefix_text..' ') or '')..string.format('0F %02X',op2)
    mnemonic,bits=sseMnemonic(pfx,op2)
    if mnemonic==nil then
      result.status='unsupported';result.reason='unsupported_opcode';return result
    end
    form='sse';sse_store=(op2==0x11 or op2==0x29);i=i+2
  elseif X87[op] then
    bits=X87[op];form='x87';i=i+1
  elseif OP1[op] then
    local info=OP1[op]
    if info.x64only and not is64bit then
      result.status='unsupported';result.reason='unsupported_opcode';return result
    end
    mnemonic=info.name;form=info.form;imm_size=info.imm;i=i+1
    -- Byte opcodes (88/8A/C6) are always 8 bits; 66/REX.W do not change them.
    -- Other opcodes use REX.W (64), 66 (16) or the default 32.
    bits=info.bits or (rex_w and 64 or (pfx[0x66] and 16 or 32))
    if form=='rm,imm' and imm_size and imm_size&gt;1 then
      imm_size=pfx[0x66] and 2 or 4
    end
  else
    result.status='unsupported';result.reason='unsupported_opcode';return result
  end
  result.opcode_text=result.opcode_text or
    ((prefix_text~='' and (prefix_text..' ') or '')..string.format('%02X',op))

  local modrm=bytes[i]
  if modrm==nil then result.status='truncated';result.reason='missing_modrm';return result end
  result.modrm=modrm
  local mod=modrm&gt;&gt;6
  local reg_ext=((modrm&gt;&gt;3)&amp;7)
  local reg=reg_ext+(rex_r and 8 or 0)
  local rm=((modrm&amp;7))+(rex_b and 8 or 0)
  local pos=i+1
  local mem=emptyMemory()
  local rm_name,reg_name

  if form=='x87' then
    if mod==3 then
      result.status='unsupported';result.reason='x87_register_form';return result
    end
    mnemonic=X87_GROUP[reg_ext]
    if mnemonic==nil then
      result.status='unsupported';result.reason='unsupported_x87_group';return result
    end
    result.operand_size=bits
  elseif form=='sse' then
    reg_name=XMM[reg+1]
    if mod~=3 then rm_name=nil else rm_name=XMM[rm+1] end
  elseif form=='reg,mem' and mod==3 then
    result.status='unsupported';result.reason='lea_register_operand';return result
  elseif form=='rm,imm' then
    reg_name=nil
    rm_name=(mod==3) and gpr(rm,bits,is64bit,addr32,has_rex) or nil
  else
    reg_name=gpr(reg,bits,is64bit,addr32,has_rex)
    rm_name=(mod==3) and gpr(rm,bits,is64bit,addr32,has_rex) or nil
  end

  if mod~=3 then
    mem.present=true
    local rm_low=modrm&amp;7
    local disp_size=0
    if rm_low==4 then
      local sib=bytes[pos]
      if sib==nil then result.status='truncated';result.reason='missing_sib';return result end
      result.sib=sib;pos=pos+1
      local scale=math.floor(2^(sib&gt;&gt;6))
      local index=((sib&gt;&gt;3)&amp;7)+(rex_x and 8 or 0)
      local base=(sib&amp;7)+(rex_b and 8 or 0)
      if not (index==4 and not rex_x) then
        mem.index_register=addrReg(index,is64bit,addr32)
        mem.scale=scale
      end
      if (sib&amp;7)==5 and mod==0 then
        mem.displacement=readSigned(bytes,pos,4)
        if mem.displacement==nil then result.status='truncated';result.reason='missing_displacement';return result end
        pos=pos+4
        if mem.index_register==nil then mem.absolute=true end
      else
        mem.base_register=addrReg(base,is64bit,addr32)
        disp_size=(mod==1) and 1 or ((mod==2) and 4 or 0)
      end
    elseif rm_low==5 and mod==0 then
      mem.displacement=readSigned(bytes,pos,4)
      if mem.displacement==nil then result.status='truncated';result.reason='missing_displacement';return result end
      pos=pos+4
      if is64bit and not addr32 then mem.rip_relative=true else mem.absolute=true end
    else
      mem.base_register=addrReg(rm_low,is64bit,addr32)
      disp_size=(mod==1) and 1 or ((mod==2) and 4 or 0)
    end
    if disp_size&gt;0 and mem.displacement==nil then
      mem.displacement=readSigned(bytes,pos,disp_size)
      if mem.displacement==nil then result.status='truncated';result.reason='missing_displacement';return result end
      pos=pos+disp_size
    end
    if mem.base_register then
      local base=mem.base_register:lower()
      mem.is_stack_reference=(base=='rsp' or base=='rbp' or base=='esp' or base=='ebp')
    end
    mem.expression_text=memText(mem)
    result.memory=mem
    result.displacement=mem.displacement
    result.rip_relative=mem.rip_relative
  end

  local immediate
  if imm_size then
    immediate=readUnsigned(bytes,pos,imm_size)
    if immediate==nil then result.status='truncated';result.reason='missing_immediate';return result end
    pos=pos+imm_size
  end
  result.length=pos-1
  result.mnemonic=mnemonic
  result.operand_size=bits
  if form=='sse' then
    result.operands_text=(mod==3)
      and ((sse_store and rm_name or reg_name)..', '..(sse_store and reg_name or rm_name))
      or ((sse_store and (mem.expression_text..', '..tostring(reg_name)))
        or (tostring(reg_name)..', '..mem.expression_text))
  elseif form=='x87' then
    result.operands_text=sizePrefix(bits)..mem.expression_text
  else
    local left,right
    if mod==3 then
      if form=='rm,imm' then left,right=rm_name,'imm'
      elseif form=='rm,reg' then left,right=rm_name,reg_name
      else left,right=reg_name,rm_name end
    elseif form=='rm,imm' then
      left,right=sizePrefix(bits)..mem.expression_text,'imm'
    elseif form=='rm,reg' then
      left,right=mem.expression_text,reg_name
    else
      left,right=reg_name,mem.expression_text
    end
    local imm_text=(immediate and string.format('0x%X',immediate)) or 'imm'
    if form=='rm,imm' then right=imm_text end
    result.operands_text=table.concat({tostring(left),tostring(right)},', ')
  end
  return result
end

return M

end
factories['dynamic'] = function(require, api)
-- Static Lua/dataflow analysis for CESuite v0.3.0-dev (030B).
-- Text only: this module never calls load/loadstring/dofile/require, never
-- executes table source and never touches CE process state.
local U = require('util')
local M = {}

M.DEFAULT_LIMITS = {
  max_tokens = 200000,
  max_depth = 12,
  max_entries = 2000,
  max_edges = 5000,
  max_candidates = 5000,
  max_symbols = 2000,
  max_wrapper_depth = 4
}

local CALLBACK_CALLEES = {
  ['registercallback'] = true,
  ['registercallbacks'] = true,
  ['setcallback'] = true,
  ['setoncallback'] = true
}

local CONTRACTS = {
  ['register.onenable'] = {
    kind = 'table_sets',
    forwards_to = 'register.multicustomscan',
    consumer_role = 'scan_spec_table',
    constructs = 'aobScanRegion'
  },
  ['register.multicustomscan'] = {
    kind = 'spec_rows',
    consumer_role = 'scan_spec_table',
    constructs = 'aobScanRegion'
  }
}

local function trim(s) return (s:gsub('^%s+',''):gsub('%s+$','')) end

local function tokenize(source, limits)
  local tokens, i, line, n = {}, 1, 1, #source
  local function push(value, kind, ln)
    tokens[#tokens+1] = {value=value, kind=kind, line=ln}
    if #tokens &gt; limits.max_tokens then error('dynamic_token_limit') end
  end
  while i &lt;= n do
    local c = source:sub(i,i)
    if c == '\n' then line=line+1; i=i+1
    elseif c == ' ' or c == '\t' or c == '\r' then i=i+1
    elseif c == '-' and source:sub(i+1,i+1) == '-' then
      local long = source:match('^%-%-%[(=*)%[', i)
      if long then
        local close = ']'..long..']'
        local finish = source:find(close, i+4, true)
        if not finish then i=n+1 else
          local chunk = source:sub(i,finish)
          local _,count = chunk:gsub('\n','\n')
          line = line + count
          i = finish + #close
        end
      else
        i = source:find('\n', i, true) or (n+1)
      end
    elseif c == '"' or c == "'" then
      local quote = c
      local startLine = line
      local parts = {}
      i = i + 1
      while i &lt;= n do
        local ch = source:sub(i,i)
        if ch == '\\' then
          local nxt = source:sub(i+1,i+1)
          local map = {n='\n', r='\r', t='\t', ['\\']='\\', ["'"]="'", ['"']='"'}
          if map[nxt] then parts[#parts+1]=map[nxt]; i=i+2
          elseif nxt == 'x' then
            local hex = source:sub(i+2,i+3)
            if hex:match('^%x%x$') then parts[#parts+1]=string.char(tonumber(hex,16)); i=i+4
            else parts[#parts+1]='\\x'; i=i+2 end
          else parts[#parts+1]=nxt; i=i+2 end
        elseif ch == quote then
          i=i+1; break
        else
          if ch == '\n' then line=line+1 end
          parts[#parts+1]=ch; i=i+1
        end
      end
      push(table.concat(parts), 'string', startLine)
    elseif c:match('%d') then
      local startLine=line
      local num
      if source:sub(i,i+2):lower() == '0x' then
        local raw = source:match('^0[xX](%x+)', i)
        num = tonumber(raw,16)
        i = i + 2 + #raw
      else
        local raw = source:match('^%d+%.?%d*[eE]?[+-]?%d*', i)
        num = tonumber(raw)
        i = i + #raw
      end
      push(tostring(num or 0), 'number', startLine)
    elseif c:match('[%a_]') then
      local startLine=line
      local name = source:match('^[%a_][%w_]*', i)
      push(name, 'name', startLine)
      i = i + #name
    elseif c == '.' and source:sub(i,i+1) == '..' then
      push('..','op',line); i=i+2
    elseif c == '=' and source:sub(i,i+1) == '==' then
      push('==','op',line); i=i+2
    elseif c == '~' and source:sub(i,i+1) == '~=' then
      push('~=','op',line); i=i+2
    elseif c == '&lt;' and source:sub(i,i+1) == '&lt;=' then
      push('&lt;=','op',line); i=i+2
    elseif c == '&gt;' and source:sub(i,i+1) == '&gt;=' then
      push('&gt;=','op',line); i=i+2
    elseif c:match('[%+%-%*/%%%^#&lt;&gt;=]') then
      push(c,'op',line); i=i+1
    else
      push(c,'punct',line); i=i+1
    end
  end
  return tokens
end

local function new_scope(parent)
  return {parent=parent, names={}}
end

local function scope_find(scope,name)
  local cur=scope
  while cur do
    local hit=cur.names[name]
    if hit then return hit end
    cur=cur.parent
  end
  return nil
end

local function table_set(tbl,key,value,line)
  if type(key)~='string' and type(key)~='number' then return end
  for _,entry in ipairs(tbl.entries) do
    if entry.key==key then entry.value=value; entry.line=line or entry.line; return end
  end
  tbl.entries[#tbl.entries+1]={key=key,value=value,line=line}
end

local function table_get(tbl,key)
  for _,entry in ipairs(tbl.entries) do
    if entry.key==key then return entry.value,entry end
  end
end

local function normalize_pattern(value)
  if type(value)~='string' then return nil end
  local s = value:gsub('%s+',''):lower():gsub('[%?%*]','x')
  if #s &lt; 4 or #s % 2 ~= 0 then return nil end
  if not s:match('^[0-9a-fx]+$') then return nil end
  local parts={}
  for i=1,#s,2 do
    parts[#parts+1]=s:sub(i,i+1)
  end
  return table.concat(parts,' ')
end

local Parser = {}
Parser.__index = Parser

local function new_parser(source, source_id, limits, helper_file)
  local token_ok, tokens = pcall(tokenize, source, limits)
  local p = setmetatable({
    source=source, source_id=source_id, limits=limits, helper_file=helper_file,
    tokens=token_ok and tokens or {}, token_error=not token_ok, pos=1,
    root=new_scope(nil), scope=nil,
    calls={}, refs={}, globals={}, unresolved={},
    candidates={}, edges={}, entries=0, specs=0
  }, Parser)
  p.scope=p.root
  return p
end

function Parser:peek(offset)
  local tok=self.tokens[self.pos+(offset or 0)]
  if not tok then return nil end
  return tok.value, tok.kind, tok.line
end

function Parser:advance()
  local tok=self.tokens[self.pos]
  self.pos=self.pos+1
  return tok
end

function Parser:at(value,offset)
  return self:peek(offset)==value
end

function Parser:node(kind,data)
  data=data or {}
  data.kind=kind
  if not data.line then
    local tok=self.tokens[self.pos-1]
    data.line=tok and tok.line or 1
  end
  data.source_script=self.source_id
  return data
end

function Parser:ref(name,line)
  local binding=scope_find(self.scope,name)
  self.refs[#self.refs+1]={name=name,line=line,
    scope=binding and 'local' or 'global', binding=binding}
  return binding
end

function Parser:resolve(node,depth)
  depth=depth or 0
  if not node or depth&gt;self.limits.max_depth then return nil end
  if node.kind=='name' then
    if node.binding then return self:resolve(node.binding.value,depth+1) end
    local helper=self.globals[node.name]
    if helper then return helper end
    return node
  elseif node.kind=='member' then
    local base=self:resolve(node.base,depth+1)
    if base and base.kind=='table' then
      local value,entry=table_get(base,node.key)
      if value then
        local resolved=self:resolve(value,depth+1)
        if resolved then
          resolved.source_line=entry.line
          resolved.source_file=base.__helper_file or node.source_file
          if resolved.kind=='table' then
            resolved.__helper_file=resolved.__helper_file or base.__helper_file
          end
        end
        return resolved
      end
    end
    return node
  elseif node.kind=='index' then
    local base=self:resolve(node.base,depth+1)
    local key=self:resolve(node.key,depth+1)
    if base and base.kind=='table' and key and (key.kind=='string' or key.kind=='number') then
      local value,entry=table_get(base,key.value)
      if value then
        local resolved=self:resolve(value,depth+1)
        if resolved then
          resolved.source_line=entry.line
          resolved.source_file=base.__helper_file or node.source_file
          if resolved.kind=='table' then
            resolved.__helper_file=resolved.__helper_file or base.__helper_file
          end
        end
        return resolved
      end
    end
    return node
  elseif node.kind=='binary' then
    local left=self:resolve(node.left,depth+1)
    local right=self:resolve(node.right,depth+1)
    if node.op=='..' and left and right and left.kind=='string' and right.kind=='string' then
      return self:node('string',{value=left.value..right.value,line=node.line})
    end
    if node.op=='and' then
      return self:node('conditional',{condition=left,fallback=right,fallback_raw=node.right,
        line=node.line,deps=self:names_of(left)})
    end
    return node
  end
  return node
end

function Parser:names_of(node,out)
  out=out or {}
  if type(node)~='table' then return out end
  if node.kind=='name' then out[#out+1]=node.name
  elseif node.kind=='member' then self:names_of(node.base,out)
  elseif node.kind=='index' then self:names_of(node.base,out);self:names_of(node.key,out)
  elseif node.kind=='call' then
    for _,arg in ipairs(node.args or {}) do self:names_of(arg,out) end
  elseif node.kind=='binary' then self:names_of(node.left,out);self:names_of(node.right,out)
  elseif node.kind=='conditional' then self:names_of(node.condition,out);self:names_of(node.fallback,out)
  end
  return out
end

function Parser:render(node)
  if type(node)~='table' then return 'unknown' end
  if node.kind=='string' then return '"'..tostring(node.value):gsub('"','\\"')..'"' end
  if node.kind=='number' then return tostring(node.value) end
  if node.kind=='boolean' then return node.value and 'true' or 'false' end
  if node.kind=='nil' then return 'nil' end
  if node.kind=='name' then return tostring(node.name) end
  if node.kind=='member' then return self:render(node.base)..'.'..tostring(node.key) end
  if node.kind=='index' then return self:render(node.base)..'['..self:render(node.key)..']' end
  if node.kind=='call' then
    local args={}
    for _,arg in ipairs(node.args or {}) do args[#args+1]=self:render(arg) end
    return self:render(node.callee)..'('..table.concat(args,', ')..')'
  end
  if node.kind=='unary' then return tostring(node.op)..self:render(node.operand) end
  if node.kind=='binary' then
    local left,right=self:render(node.left),self:render(node.right)
    if node.op=='and' or node.op=='or' then
      return left..' '..node.op..' '..right
    end
    return '('..left..' '..tostring(node.op)..' '..right..')'
  end
  if node.kind=='conditional' then
    return self:render(node.condition)..' and '..self:render(node.fallback)
  end
  return 'unknown'
end

function Parser:parse_table()
  local line=self.tokens[self.pos].line
  self.pos=self.pos+1
  local tbl=self:node('table',{entries={},line=line})
  local array_index=1
  while self:peek() and self:peek()~='}' do
    if #tbl.entries&gt;=self.limits.max_entries then
      self.unresolved[#self.unresolved+1]={code='TABLE_LIMIT',line=line,source_script=self.source_id}
      break
    end
    local key
    if self:at('[') then
      self.pos=self.pos+1
      local k=self:parse_expr()
      if not self:at(']') then break end
      self.pos=self.pos+1
      if not self:at('=') then break end
      self.pos=self.pos+1
      key=self:resolve(k)
    elseif self.tokens[self.pos] and self.tokens[self.pos].kind=='name'
        and self.tokens[self.pos+1] and self.tokens[self.pos+1].value=='=' then
      local name=self:advance().value
      self.pos=self.pos+1
      key=self:node('string',{value=name,line=line})
    else
      key=self:node('number',{value=array_index,line=line})
      array_index=array_index+1
    end
    local value=self:parse_expr()
    if key and (key.kind=='string' or key.kind=='number') then
      table_set(tbl,key.value,value,value and value.line or line)
    end
    if self:at(',') or self:at(';') then self.pos=self.pos+1
    elseif not self:at('}') then
      while self:peek() and self:peek()~='}' and self:peek()~=',' do self.pos=self.pos+1 end
      if self:at(',') then self.pos=self.pos+1 end
    end
  end
  if self:at('}') then self.pos=self.pos+1 end
  return tbl
end

function Parser:parse_primary()
  local value,kind,ln=self:peek()
  if not value then return self:node('unknown',{line=1}) end
  local line=ln
  if kind=='string' then self.pos=self.pos+1; return self:node('string',{value=value,line=line}) end
  if kind=='number' then self.pos=self.pos+1; return self:node('number',{value=tonumber(value) or value,line=line}) end
  if kind=='name' then
    if value=='true' then self.pos=self.pos+1; return self:node('boolean',{value=true,line=line}) end
    if value=='false' then self.pos=self.pos+1; return self:node('boolean',{value=false,line=line}) end
    if value=='nil' then self.pos=self.pos+1; return self:node('nil',{line=line}) end
    if value=='function' then
      self.pos=self.pos+1
      self:skip_function_body()
      return self:node('unknown',{line=line})
    end
    self.pos=self.pos+1
    local binding=self:ref(value,ln)
    local node=self:node('name',{name=value,binding=binding,line=line})
    while self:at('.') do
      self.pos=self.pos+1
      local field=self:peek()
      if not field then break end
      self.pos=self.pos+1
      node=self:node('member',{base=node,key=field,line=line,source_file=self.helper_file})
    end
    while self:at('[') do
      self.pos=self.pos+1
      local key=self:parse_expr()
      if not self:at(']') then break end
      self.pos=self.pos+1
      node=self:node('index',{base=node,key=key,line=line,source_file=self.helper_file})
    end
    return node
  end
  if value=='{' then return self:parse_table() end
  if value=='(' then
    self.pos=self.pos+1
    local inner=self:parse_expr()
    if self:at(')') then self.pos=self.pos+1 end
    return inner
  end
  if value=='not' or value=='-' or value=='#' then
    self.pos=self.pos+1
    local operand=self:parse_expr(9)
    return self:node('unary',{op=value,operand=operand,line=line})
  end
  self.pos=self.pos+1
  return self:node('unknown',{line=line})
end

function Parser:path_of(node)
  if node.kind=='name' then return node.name end
  if node.kind=='member' then
    local base=self:path_of(node.base)
    return base and (base..'.'..tostring(node.key)) or nil
  end
  if node.kind=='index' then
    local base=self:path_of(node.base)
    local key=self:resolve(node.key)
    if base and key and (key.kind=='string' or key.kind=='number') then
      return base..'['..tostring(key.value)..']'
    end
  end
  return nil
end

function Parser:parse_postfix(node)
  while self:at('(') do
    self.pos=self.pos+1
    local args={}
    while self:peek() and self:peek()~=')' do
      args[#args+1]=self:parse_expr()
      if self:at(',') then self.pos=self.pos+1 else break end
    end
    if self:at(')') then self.pos=self.pos+1 end
    local callee=self:path_of(node)
    node=self:node('call',{callee=node,callee_path=callee,args=args,line=node.line})
    self.calls[#self.calls+1]=node
  end
  return node
end

local PRECEDENCE={['or']=1,['and']=2,['==']=3,['~=']=3,['&lt;']=3,['&gt;']=3,['&lt;=']=3,['&gt;=']=3,
  ['..']=4,['+']=5,['-']=5,['*']=6,['/']=6,['%']=6,['^']=7}

function Parser:parse_expr(min_prec)
  min_prec=min_prec or 0
  local left=self:parse_primary()
  left=self:parse_postfix(left)
  while true do
    local op=self:peek()
    local prec=op and PRECEDENCE[op]
    if not prec or prec&lt;min_prec then break end
    local op_line=self.tokens[self.pos].line
    self.pos=self.pos+1
    local right=self:parse_expr(prec+1)
    left=self:node('binary',{op=op,left=left,right=right,line=op_line})
  end
  return left
end

function Parser:skip_function_body()
  if self:at('(') then
    self.pos=self.pos+1
    while self:peek() and self:peek()~=')' do self.pos=self.pos+1 end
    if self:at(')') then self.pos=self.pos+1 end
  end
  local depth=1
  while self:peek() do
    local v=self:advance().value
    if v=='function' or v=='if' or v=='for' or v=='while' or v=='do' then depth=depth+1
    elseif v=='end' then depth=depth-1; if depth==0 then return end end
  end
end

function Parser:assign(target,value)
  if target.kind=='name' then
    if target.binding then target.binding.value=value
    else self.globals[target.name]=value end
  elseif target.kind=='member' then
    local base=self:resolve(target.base)
    if base and base.kind=='table' then table_set(base,target.key,value,target.line) end
  elseif target.kind=='index' then
    local base=self:resolve(target.base)
    local key=self:resolve(target.key)
    if base and base.kind=='table' and key and (key.kind=='string' or key.kind=='number') then
      table_set(base,key.value,value,target.line)
    end
  end
end

function Parser:parse_statement()
  local v=self:peek()
  if not v then return end
  if v==';' then self.pos=self.pos+1; return end
  if v=='local' then
    self.pos=self.pos+1
    if self:at('function') then
      self.pos=self.pos+1
      local name=self:advance().value
      if self:at('(') then
        self.pos=self.pos+1
        while self:peek() and self:peek()~=')' do self.pos=self.pos+1 end
        if self:at(')') then self.pos=self.pos+1 end
      end
      local outer=self.scope
      self.scope=new_scope(outer)
      self:parse_block('end')
      self.scope=outer
      if self:at('end') then self.pos=self.pos+1 end
      outer.names[name]={value=self:node('unknown',{line=1})}
      return
    end
    local names={}
    while self:peek() and self:peek()~='=' do
      local name=self:advance().value
      names[#names+1]=name
      if self:at(',') then self.pos=self.pos+1 else break end
    end
    local values={}
    if self:at('=') then
      self.pos=self.pos+1
      values[#values+1]=self:parse_expr()
      while self:at(',') do self.pos=self.pos+1; values[#values+1]=self:parse_expr() end
    end
    for i,name in ipairs(names) do
      local value=values[i] or self:node('nil',{})
      self.scope.names[name]={value=value,line=value.line}
    end
    return
  elseif v=='function' then
    self.pos=self.pos+1
    while self:peek() and not self:at('(') do self.pos=self.pos+1 end
    self:skip_function_body()
    return
  elseif v=='return' then
    self.pos=self.pos+1
    if self:peek() and not self:at('end') then self:parse_expr() end
    while self:peek() and not self:at('end') and not self:at(';') do self.pos=self.pos+1 end
    return
  elseif v=='if' then
    self.pos=self.pos+1; self:parse_expr()
    if self:at('then') then self.pos=self.pos+1 end
    local outer=self.scope; self.scope=new_scope(outer)
    self:parse_block('end')
    self.scope=outer
    if self:at('end') then self.pos=self.pos+1 end
    return
  elseif v=='do' then
    self.pos=self.pos+1
    local outer=self.scope; self.scope=new_scope(outer)
    self:parse_block('end')
    self.scope=outer
    if self:at('end') then self.pos=self.pos+1 end
    return
  elseif v=='for' or v=='while' then
    while self:peek() and not self:at('do') do self.pos=self.pos+1 end
    if self:at('do') then self.pos=self.pos+1 end
    local outer=self.scope; self.scope=new_scope(outer)
    self:parse_block('end')
    self.scope=outer
    if self:at('end') then self.pos=self.pos+1 end
    return
  end
  if v=='end' or v=='else' or v=='elseif' then return end

  local first=self:parse_expr()
  if self:at('=') or self:at(',') then
    local targets={first}
    while self:at(',') do self.pos=self.pos+1; targets[#targets+1]=self:parse_expr() end
    if self:at('=') then self.pos=self.pos+1 end
    local values={}
    values[#values+1]=self:parse_expr()
    while self:at(',') do self.pos=self.pos+1; values[#values+1]=self:parse_expr() end
    for i,target in ipairs(targets) do self:assign(target,values[i] or self:node('nil',{})) end
  end
end

function Parser:parse_block(stop)
  while self:peek() and self:peek()~=stop do
    local before=self.pos
    self:parse_statement()
    if self.pos==before then
      self.pos=self.pos+1
      if self.pos&gt;#self.tokens then break end
    end
  end
end

-- Strip AA markers while preserving line numbers.
local function prepare_text(text)
  local out={}
  for line in ((text or '')..'\n'):gmatch('(.-)\n') do
    local s=trim(line)
    if s=='{$lua}' or s=='{$asm}' or s=='[ENABLE]' or s=='[DISABLE]' then
      out[#out+1]=''
    else
      out[#out+1]=line
    end
  end
  return table.concat(out,'\n')
end

local function helper_globals(options, limits)
  local globals={}
  local helpers=options.helpers or {}
  local function add(helper)
    if type(helper)~='table' or type(helper.text)~='string' then return end
    local p=new_parser(helper.text,helper.name or 'helper',limits,helper.file)
    local ok=pcall(function() p:parse_block(nil) end)
    if not ok then return end
    local alias=helper.alias
    local value
    if alias then
      local hit=p.root.names[alias]
      value=hit and p:resolve(hit.value)
    end
    if not value or value.kind~='table' then
      for _,binding in pairs(p.root.names) do
        local candidate=p:resolve(binding.value)
        if candidate and candidate.kind=='table' then value=candidate;break end
      end
    end
    if value and value.kind=='table' then
      value.__helper_file=helper.file or (helper.name and (helper.name..'.lua')) or nil
      globals[helper.name]=value
    end
  end
  if #helpers&gt;0 then
    for _,helper in ipairs(helpers) do add(helper) end
  else
    for name,helper in pairs(helpers) do
      if type(helper)=='string' then add({name=name,text=helper})
      elseif type(helper)=='table' then helper.name=helper.name or name;add(helper) end
    end
  end
  return globals
end

local function edge(ctx,relation,from,to,provenance,line,script,extra)
  if #ctx.edges&gt;=ctx.limits.max_edges then
    if not ctx.edge_limit_reported then
      ctx.edge_limit_reported=true
      ctx.unresolved[#ctx.unresolved+1]={code='EDGE_LIMIT',line=line,
        source_script=script or ctx.source_id}
    end
    ctx.limit=true
    return
  end
  local f,t=tostring(from),tostring(to)
  local key=table.concat({relation,f,t,script or ctx.source_id or '',
    tostring(line or ''),provenance or 'unknown'},'|')
  ctx.edge_keys=ctx.edge_keys or {}
  if ctx.edge_keys[key] then return end
  ctx.edge_keys[key]=true
  local e={relation=relation,from=f,to=t,
    provenance=provenance or 'unknown',source_script=script or ctx.source_id,
    source_line=line,status='linked',confidence='high'}
  if extra then for k,v in pairs(extra) do e[k]=v end end
  ctx.edges[#ctx.edges+1]=e
end

local function add_candidate(ctx,row,consumer,key)
  if #ctx.candidates&gt;=ctx.limits.max_candidates then
    ctx.limit=true
    if not ctx.candidate_limit_reported then
      ctx.candidate_limit_reported=true
      ctx.unresolved[#ctx.unresolved+1]={code='CANDIDATE_LIMIT',
        line=row.line,source_script=ctx.source_id}
    end
    return
  end
  local entries=row.entries or {}
  local first=entries[1] and ctx.parser:resolve(entries[1].value) or nil
  local second_raw=entries[2] and entries[2].value or nil
  local second=second_raw and ctx.parser:resolve(second_raw) or nil
  local symbol=nil
  local kind='unknown'
  local pattern=nil
  local derived=nil
  local conditional=nil
  local status='unresolved'
  if first and first.kind=='string' then symbol=first.value end
  if first and first.kind=='conditional' then
    kind='conditional_pattern'
    conditional=first
    for _,name in ipairs(first.deps or {}) do
      ctx.unresolved[#ctx.unresolved+1]={code='CONDITIONAL_DEPENDENCY',name=name,
        line=first.line,source_script=ctx.source_id}
    end
  elseif symbol and second and second.kind=='string' and
      not (second_raw and (second_raw.kind=='member' or second_raw.kind=='index')) then
    kind='literal_pattern'
    pattern=second.value
    status='candidate'
  elseif symbol and second_raw and (second_raw.kind=='member' or second_raw.kind=='index') then
    kind='derived_pattern'
    local resolved=ctx.parser:resolve(second_raw)
    if resolved and resolved.kind=='string' then
      pattern=resolved.value
      status='candidate'
      derived={path=ctx.parser:path_of(second_raw),source_file=resolved.source_file,
        source_line=resolved.source_line}
      edge(ctx,'derives_from','candidate',ctx.parser:path_of(second_raw) or 'helper',
        'lua_dynamic',second.line,ctx.source_id)
    else
      ctx.unresolved[#ctx.unresolved+1]={code='UNRESOLVED_DERIVED',
        name=ctx.parser:path_of(second_raw) or '?',line=second_raw.line,source_script=ctx.source_id}
    end
  elseif symbol then
    kind='symbol_only'
    status='not_applicable'
  else
    status='unresolved'
  end
  local normalized=normalize_pattern(pattern)
  local id=string.format('dyn-%s-%d-%03d',ctx.source_id,row.line or 0,#ctx.candidates+1)
  local candidate={id=id,pattern=pattern,kind=kind,symbol=symbol or U.null,
    source_script=ctx.source_id,source_line=row.line,consumer=consumer,
    key=key or U.null,status=status,runtime_validated=false,
    provenance=U.array({
      {kind='lua_literal',source_script=ctx.source_id,line=first and first.line or row.line},
      {kind='wrapper',source_script=ctx.source_id,line=row.line,detail=consumer}
    })}
  if normalized then
    candidate.pattern_length=#normalized:gsub('%s','')/2
  end
  if derived then candidate.derivation=derived end
  if conditional then
    local deps,seen=U.array(),{}
    for _,name in ipairs(conditional.deps or {}) do
      if not seen[name] then seen[name]=true;deps[#deps+1]=name end
    end
    candidate.condition={
      kind='conditional_expression',
      text=ctx.parser:render(conditional.condition)..' and '..
        ctx.parser:render(conditional.fallback_raw or conditional.fallback),
      dependencies=deps,
      resolution='unknown',
      fallback=ctx.parser:render(conditional.fallback_raw or conditional.fallback)
    }
    candidate.dependencies=deps
  end
  ctx.candidates[#ctx.candidates+1]=candidate
  if kind=='literal_pattern' then
    ctx.counts.literal=ctx.counts.literal+1
    ctx.counts.candidates=ctx.counts.candidates+1
  elseif kind=='derived_pattern' then
    ctx.counts.derived=ctx.counts.derived+1
    ctx.counts.candidates=ctx.counts.candidates+1
  elseif kind=='conditional_pattern' then
    ctx.counts.conditional=ctx.counts.conditional+1
  end
  if kind=='symbol_only' or kind=='conditional_pattern' then
    ctx.counts.symbol_only=ctx.counts.symbol_only+1
  end
  if symbol then
    ctx.symbols[symbol]=(ctx.symbols[symbol] or 0)+1
    edge(ctx,'provides',consumer,symbol,'wrapper',row.line,ctx.source_id)
  end
  if normalized then
    ctx.patterns[normalized]=true
    if kind=='literal_pattern' then ctx.literal_patterns[normalized]=true end
    edge(ctx,'constructs',consumer,'aobScanRegion','wrapper',row.line,ctx.source_id)
  end
end

local function spec_rows(ctx,table_node,consumer,key,depth)
  if depth&gt;ctx.limits.max_wrapper_depth then
    ctx.unresolved[#ctx.unresolved+1]={code='WRAPPER_DEPTH_LIMIT',
      line=table_node.line,source_script=ctx.source_id}
    return
  end
  for _,entry in ipairs(table_node.entries or {}) do
    local row=ctx.parser:resolve(entry.value)
    if row and row.kind=='table' then
      add_candidate(ctx,row,consumer,key)
    else
      ctx.unresolved[#ctx.unresolved+1]={code='UNRESOLVED_SPEC',
        line=entry.line,source_script=ctx.source_id}
    end
  end
end

local function process_call(ctx,call)
  local path=call.callee_path and call.callee_path:lower() or ''
  if CALLBACK_CALLEES[path] then
    for _,arg in ipairs(call.args or {}) do
      local name
      if arg.kind=='name' then name=arg.name
      elseif arg.kind=='member' or arg.kind=='index' then name=ctx.parser:path_of(arg) end
      edge(ctx,'registers',name or 'anonymous_callback',call.callee_path,
        'callback',call.line,ctx.source_id,{callback=true})
    end
    return
  end
  local contract=CONTRACTS[path]
  if not contract then return end
  local consumer=call.callee_path
  if contract.kind=='table_sets' then
    for _,arg in ipairs(call.args or {}) do
      local value=ctx.parser:resolve(arg)
      if value and value.kind=='table' then
        ctx.entries=ctx.entries+#value.entries
        edge(ctx,'passes_to',arg.kind=='name' and arg.name or 'table',consumer,
          'wrapper',call.line,ctx.source_id)
        for _,entry in ipairs(value.entries) do
          local list=ctx.parser:resolve(entry.value)
          if list and list.kind=='table' then
            spec_rows(ctx,list,consumer,tostring(entry.key),1)
          else
            ctx.unresolved[#ctx.unresolved+1]={code='UNRESOLVED_TABLE_SET',
              line=entry.line,source_script=ctx.source_id}
          end
        end
      else
        ctx.unresolved[#ctx.unresolved+1]={code='UNRESOLVED_WRAPPER_ARGUMENT',
          line=call.line,source_script=ctx.source_id}
      end
    end
    if contract.forwards_to then
      edge(ctx,'calls',consumer,contract.forwards_to,'wrapper',call.line,ctx.source_id)
      edge(ctx,'constructs',contract.forwards_to,contract.constructs or 'aobScanRegion',
        'wrapper',call.line,ctx.source_id)
    end
  else
    for _,arg in ipairs(call.args or {}) do
      local row=ctx.parser:resolve(arg)
      if row and row.kind=='table' then add_candidate(ctx,row,consumer,nil)
      else ctx.unresolved[#ctx.unresolved+1]={code='UNRESOLVED_SPEC',
        line=call.line,source_script=ctx.source_id} end
    end
  end
end

local function loader_edges(ctx,text,script_id)
  if type(text)~='string' then return end
  for name in text:gmatch("findTableFile%s*%(%s*['\"]([^'\"]+)['\"]%s*%)") do
    edge(ctx,'includes',script_id,name,'include',nil,script_id)
  end
  for name in text:gmatch("include%s*%(%s*['\"]([%a_][%w_]*)['\"]%s*%)") do
    edge(ctx,'includes',script_id,name..'.lua','include',nil,script_id)
  end
  for name in text:gmatch('_G%s*%.%s*([%a_][%w_]*)%s*=') do
    ctx.providers[name]=true
    edge(ctx,'provides',script_id,name,'external_helper',nil,script_id)
  end
  for name in text:gmatch("_G%s*%[%s*['\"]([%a_][%w_]*)['\"]%s*%]%s*=") do
    ctx.providers[name]=true
    edge(ctx,'provides',script_id,name,'external_helper',nil,script_id)
  end
end

function M.analyze(sources, options)
  options=options or {}
  local limits={}
  for k,v in pairs(M.DEFAULT_LIMITS) do limits[k]=v end
  for k,v in pairs(options.limits or {}) do limits[k]=v end
  local ctx={limits=limits,source_id='dynamic',edges={},candidates={},entries=0,
    unresolved={},deps={},counts={entries=0,specs=0,literal=0,derived=0,
      conditional=0,symbol_only=0,candidates=0},symbols={},patterns={},providers={},
    literal_patterns={},limit=false}
  local globals=helper_globals(options,limits)

  for _,source in ipairs(sources or {}) do
    local text=prepare_text(source.text or '')
    local p=new_parser(text,source.script_id or 'source',limits)
    p.globals=globals
    if p.token_error then
      ctx.unresolved[#ctx.unresolved+1]={code='PARSE_LIMIT',message='token limit',
        line=nil,source_script=source.script_id}
      ctx.limit=true
    end
    local ok,err=pcall(function() p:parse_block(nil) end)
    if not ok then
      ctx.unresolved[#ctx.unresolved+1]={code='PARSE_LIMIT',message=tostring(err),
        line=nil,source_script=source.script_id}
      ctx.limit=true
    end
    for _,entry in ipairs(p.unresolved or {}) do
      ctx.unresolved[#ctx.unresolved+1]=entry
      if type(entry.code)=='string' and entry.code:match('_LIMIT$') then ctx.limit=true end
    end
    for name,binding in pairs(p.root.names) do
      local value=p:resolve(binding.value)
      if value and value.kind=='table' and not globals[name] then globals[name]=value end
    end
    ctx.source_id=source.script_id or 'source'
    ctx.parser=p
    for _,call in ipairs(p.calls) do process_call(ctx,call) end
    for _,ref in ipairs(p.refs) do
      local provenance
      if ref.scope=='local' then provenance='lua_local'
      elseif globals[ref.name] then provenance='external_helper'
      elseif ref.name=='md5memory' or ref.name=='process' or ref.name=='memrec' then provenance='runtime'
      else provenance='unknown' end
      ctx.deps[#ctx.deps+1]={name=ref.name,line=ref.line,scope=ref.scope,
        provenance=provenance,source_script=ctx.source_id,
        status=ref.scope=='local' and 'local' or 'unresolved'}
      if ref.scope=='global' then
        edge(ctx,'requires',ctx.source_id,ref.name,provenance,ref.line,ctx.source_id)
      end
    end
  end
  if options.loader then loader_edges(ctx,options.loader,options.loader_script_id or 'loader') end

  local counts=ctx.counts
  counts.entries=ctx.entries
  counts.literal_unique=0
  for _ in pairs(ctx.literal_patterns) do counts.literal_unique=counts.literal_unique+1 end
  counts.unique_symbols=0
  for _ in pairs(ctx.symbols) do counts.unique_symbols=counts.unique_symbols+1 end
  counts.symbol_only_pure=counts.symbol_only-counts.conditional
  counts.specs=#ctx.candidates
  counts.runtime_validated=0

  table.sort(ctx.candidates,function(a,b)
    if a.source_script~=b.source_script then return a.source_script&lt;b.source_script end
    if a.source_line~=b.source_line then return a.source_line&lt;b.source_line end
    return a.id&lt;b.id
  end)
  table.sort(ctx.edges,function(a,b)
    if a.source_script~=b.source_script then return a.source_script&lt;b.source_script end
    if (a.source_line or 0)~=(b.source_line or 0) then return (a.source_line or 0)&lt;(b.source_line or 0) end
    if a.relation~=b.relation then return a.relation&lt;b.relation end
    if a.from~=b.from then return tostring(a.from)&lt;tostring(b.from) end
    return tostring(a.to)&lt;tostring(b.to)
  end)
  table.sort(ctx.unresolved,function(a,b)
    if (a.source_script or '')~=(b.source_script or '') then return (a.source_script or '')&lt;(b.source_script or '') end
    return (a.line or 0)&lt;(b.line or 0)
  end)
  table.sort(ctx.deps,function(a,b)
    if a.source_script~=b.source_script then return a.source_script&lt;b.source_script end
    if a.line~=b.line then return a.line&lt;b.line end
    return a.name&lt;b.name
  end)

  local patterns=U.array()
  for _,candidate in ipairs(ctx.candidates) do patterns[#patterns+1]=candidate end
  local edges=U.array()
  for _,e in ipairs(ctx.edges) do edges[#edges+1]=e end
  local unresolved=U.array()
  for _,u in ipairs(ctx.unresolved) do unresolved[#unresolved+1]=u end
  local deps=U.array()
  for _,d in ipairs(ctx.deps) do deps[#deps+1]=d end
  local providers=U.array()
  for name in pairs(ctx.providers) do providers[#providers+1]=name end
  table.sort(providers)
  local nodes=U.array()
  for name in pairs(ctx.providers) do
    nodes[#nodes+1]={id='provider:'..name,kind='helper',name=name,status='linked'}
  end
  for symbol in pairs(ctx.symbols) do
    nodes[#nodes+1]={id='symbol:'..symbol,kind='symbol',name=symbol,status='discovered'}
  end
  table.sort(nodes,function(a,b) return a.id&lt;b.id end)

  return {
    version='0.1',
    limits=limits,
    patterns=patterns,
    edges=edges,
    nodes=nodes,
    dependencies=deps,
    providers=providers,
    counts=counts,
    unresolved=unresolved,
    status=ctx.limit and 'limit_reached' or 'complete'
  }
end

-- Merge embedded Lua blocks of the same parent script into a line-preserving
-- source unit. AA scripts are ignored; only captured Lua text is analyzed.
function M.sources_from_scripts(scripts)
  local groups = {}
  for _,script in ipairs(scripts or {}) do
    if script.language == 'Lua' and type(script.text) == 'string' then
      local key = script.parent_script_id or script.id
      local group = groups[key]
      if not group then
        group = {script_id=key, blocks={}}
        groups[key] = group
      end
      group.blocks[#group.blocks+1] = {text=script.text, line=script.line or 1}
    end
  end
  local sources = {}
  for key,group in pairs(groups) do
    table.sort(group.blocks, function(a,b) return a.line &lt; b.line end)
    local maxline = 1
    local split = {}
    for _,block in ipairs(group.blocks) do
      local lines = {}
      for line in (block.text..'\n'):gmatch('(.-)\n') do lines[#lines+1]=line end
      split[#split+1] = {start=block.line, lines=lines}
      maxline = math.max(maxline, block.line + #lines - 1)
    end
    local out = {}
    for i=1,maxline do out[i] = '' end
    for _,block in ipairs(split) do
      for offset,line in ipairs(block.lines) do
        local index = block.start + offset - 1
        if index &lt;= maxline then out[index] = line end
      end
    end
    sources[#sources+1] = {script_id=key, text=table.concat(out, '\n')}
  end
  table.sort(sources, function(a,b) return a.script_id &lt; b.script_id end)
  return sources
end


return M

end
factories['environment'] = function(require, api)
local U = require('util')
local M = {}
function M.capture(api, report)
  local pid, err = U.call(api, 'getOpenedProcessID')
  local target = {pid=pid or U.null, attached=type(pid)=='number' and pid&gt;0,
    name=type(api.process)=='string' and api.process or U.null, architecture='unknown',
    build_fingerprint=U.null}
  report.target=target
  report.modules=U.array()
  report.ce_version=tostring(U.call(api, 'getCEVersion') or 'unknown')
  if not target.attached then
    U.warn(report,'PROCESS-UNAVAILABLE',err or 'No process attached; no runtime reads or scans.')
    return
  end
  local x64=U.call(api,'targetIs64Bit')
  if type(x64)=='boolean' then target.architecture=x64 and 'x64' or 'x86' end
  local modules, failure=U.call(api,'enumModules')
  if type(modules)~='table' then
    -- A cached PID without a provable module inventory is not a live target.
    report.target.attached=false
    report.target.name=U.null
    U.warn(report,'MODULES-UNAVAILABLE',failure or 'Module enumeration failed')
    return
  end
  -- Resolve the exact same name/path candidate set used by AOB bounds.
  for _,m in ipairs(modules) do
    table.insert(report.modules,{name=m.Name or U.null,base=U.hex(m.Address),size=U.null,
      path=m.PathToFile or U.null,architecture=m.Is64Bit==nil and 'unknown' or (m.Is64Bit and 'x64' or 'x86')})
  end
  if #report.modules==0 then
    -- Cheat Engine can retain a stale PID after the target exits. An empty
    -- module inventory cannot prove a live target, so fail closed.
    report.target.attached=false
    report.target.name=U.null
    U.warn(report,'PROCESS-UNAVAILABLE','No live target: the module inventory is empty.')
    return
  end
  for i,m in ipairs(modules) do
    local candidate,reason=U.moduleMatch(m.Name,report.modules)
    local _,pathReason=U.moduleMatch(m.PathToFile,report.modules)
    if pathReason and pathReason:match('^ambiguous') then candidate=nil;reason=pathReason end
    if not candidate then
      U.warn(report,'MODULE-SNAPSHOT-INCOMPLETE',tostring(reason)..'; size lookup omitted.')
    else
      local size=U.call(api,'getModuleSize',m.Name)
