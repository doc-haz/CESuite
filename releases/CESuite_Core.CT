      if val:sub(1, 1) == '\n' then val = val:sub(2) end
      tokens[#tokens+1] = { value = val, line = line, kind = 'string' }
      local sub = source:sub(i, s_end + #close - 1)
      for _ in sub:gmatch('\n') do line = line + 1 end
      i = s_end + #close
    elseif c == '"' or c == "'" then
      local q = c
      local s_start = i + 1
